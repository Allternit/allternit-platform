{
  "name": "@allternit/apps-cli",
  "version": "0.1.0",
  "description": "The allternit CLI: create-allternit-app, allternit dev | test | package | submit.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "allternit": "./dist/bin.js",
    "create-allternit-app": "./dist/create-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@allternit/apps-server": "workspace:*",
    "@allternit/look-packs": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
