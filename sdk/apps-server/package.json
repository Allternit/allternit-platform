{
  "name": "@allternit/apps-server",
  "version": "0.2.0",
  "description": "Thin helpers over the MCP SDK v2 (protocol 2026-07-28, dual-era) and ext-apps for building Allternit Mini apps: defineApp, appTool, view, a streamable-HTTP starter and one allternit.app.json manifest.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./manifest": { "types": "./dist/manifest.d.ts", "import": "./dist/manifest.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@allternit/apps-bridge": "workspace:*",
    "@allternit/apps-ui": "workspace:*",
    "@allternit/look-packs": "workspace:*",
    "@allternit/mcp-events": "workspace:*",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "catalog:",
    "@types/node": "^24.10.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
