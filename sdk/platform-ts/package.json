{
  "name": "@allternit/platform",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript SDK for the Allternit Platform API (agents, conversations, numbers, messaging, webhooks, usage).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "generate": "python3 ../../scripts/platform-sdk/generate.py",
    "generate:check": "python3 ../../scripts/platform-sdk/generate.py --check",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  }
}
