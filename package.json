{
  "name": "allternitchitect",
  "version": "1.0.0",
  "description": "allternit - AI Governance and Workflow System",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "concurrently \"cd cmd/allternit-api && cargo run\" \"pnpm --filter @allternit/runtime serve\" \"pnpm --filter @allternit/desktop dev\"",
    "dev:platform-stack:watch": "node scripts/dev-stack-watch.cjs",
    "dev:api:watch": "node scripts/dev-stack-watch.cjs --api-only",
    "dev:gizzi:watch": "node scripts/dev-stack-watch.cjs --gizzi-only",
    "config:company": "node scripts/generate-company-config.cjs",
    "config:company:write": "node scripts/generate-company-config.cjs --out=resources/company.json",
    "docs:lint": "node scripts/docs-lint.cjs",
    "dev:api": "cd cmd/allternit-api && cargo run",
    "dev:research": "bash services/open-notebook/dev.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config tests/vitest.config.ts",
    "test:unit": "vitest run",
    "test:e2e": "echo 'No e2e tests configured'",
    "test:e2e:headed": "echo 'No e2e tests configured'",
    "test:e2e:debug": "echo 'No e2e tests configured'",
    "test:e2e:ci": "echo 'No e2e tests configured'",
    "test:benchmark": "vitest run tests/benchmarks",
    "test:coverage": "vitest run --coverage",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf dist",
    "clean:rust-standalone": "rm -rf cmd/launcher/target rails/target ../../distribution/launcher-desktop/target ../../distribution/launcher-simplified/target",
    "clean:rust-full": "cargo clean",
    "prune:pnpm": "pnpm store prune",
    "sweep:rust": "cargo sweep -r -t 14 || echo 'Install cargo-sweep with: cargo install cargo-sweep'",
    "clean:all-safe": "pnpm run clean && pnpm run clean:rust-standalone && pnpm run prune:pnpm",
    "maintenance:cleanup": "bash scripts/maintenance/cleanup.sh",
    "shell": "pnpm --filter @allternit/desktop dev",
    "shell:web": "pnpm --filter @allternit/desktop dev",
    "shell:desktop": "pnpm --filter @allternit/desktop dev",
    "tui": "bun run --cwd cmd/gizzi-code dev",
    "tui:build": "bun run --cwd cmd/gizzi-code build",
    "tui:test": "bun run --cwd cmd/gizzi-code test",
    "start:all": "concurrently \"pnpm --filter @allternit/runtime serve\" \"pnpm --filter @allternit/desktop dev\""
  },
  "keywords": [
    "allternit",
    "ai",
    "governance",
    "workflow"
  ],
  "author": "allternit Team",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.28",
    "@vitest/coverage-v8": "^1.0.0",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^8.2.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.3",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.58.2",
    "pptxgenjs": "^4.0.1",
    "sharp": "^0.34.5",
    "simple-icons": "^16.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^1.0.0",
    "ws": "^8.20.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "jszip": "^3.10.1",
    "sqlite-vec": "^0.1.9",
    "utif2": "^4.1.0"
  }
}
