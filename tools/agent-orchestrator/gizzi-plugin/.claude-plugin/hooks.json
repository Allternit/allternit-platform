{
  "description": "Steering checkpoint Stop hook, git-discipline gate, commit gate, session worktree ritual, and shared-checkout guard. Commands run in the session's project directory; they no-op unless the project has .steering/checkpoint.md.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .steering/bin/git-discipline-gate.sh",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .steering/bin/steer-stop.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .steering/bin/steer-pre-commit-gate.sh",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash .steering/bin/guard-main-checkout.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .steering/bin/session-worktree.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
