#!/usr/bin/env bash
# steer-checkpoint <repo-path> <from-name> [-f <markdown-file>]
# Write <repo>/.steering/checkpoint.md deterministically from stdin or a file,
# then post a Factory steer/checkpoint event if the API is up.
# Exits 0 on success; prints the checkpoint path.
set -euo pipefail
[ $# -ge 2 ] || { echo "usage: steer-checkpoint <repo-path> <from-name> [-f <file>]  (markdown body via stdin or -f)" >&2; exit 2; }

REPO="$1"; FROM="$2"; shift 2
FILE=""
if [ "${1:-}" = "-f" ]; then FILE="${2:?missing file after -f}"; fi

[ -d "$REPO" ] || { echo "error: repo $REPO does not exist" >&2; exit 1; }
mkdir -p "$REPO/.steering"

OUT="$REPO/.steering/checkpoint.md"
TS=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

{
  echo "<!-- steering checkpoint written by steer-checkpoint at $TS from $FROM -->"
  if [ -n "$FILE" ]; then
    cat "$FILE"
  else
    cat
  fi
} > "$OUT"

echo "wrote $OUT"

# Factory checkpoint event (best-effort, non-fatal)
if curl -s --max-time 3 http://127.0.0.1:8013/api/factory/peers >/dev/null 2>&1; then
  NOTES=$(head -c 200 "$OUT" | tr '\n' ' ' | sed 's/"/\\"/g')
  RESP=$(curl -s --max-time 5 -X POST http://127.0.0.1:8013/api/factory/steer/checkpoint \
    -H "Content-Type: application/json" \
    -d "{\"cwd\":\"$REPO\",\"notes\":\"$NOTES\"}" 2>/dev/null || true)
  [ -n "$RESP" ] && echo "factory: $RESP"
fi
