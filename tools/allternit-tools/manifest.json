{
  "version": 1,
  "updated": "2026-10-01",
  "prefix": "~/.allternit/tools",
  "harness": "infrastructure/executor/ao-engine/src/ao/harness/harness.json",
  "_notes": {
    "canonical": "Single install manifest for every CLI tool / agent Allternit can drive (plan D0/D1). Install, verify, sign-in and terms data live here. Wiring data (skills/rules/MCP paths) is NOT duplicated: tools with `harness` point at ao's harness.json entry, and test/manifest.test.mjs asserts the pins here match harness.json byte-for-byte on the primary package.",
    "pins": "Every installable tool is pinned. npm pins were checked on registry.npmjs.org and PyPI on 2026-10-01; harness.json pins (verified 2026-09-10) are kept as-is so ao and this installer install the same version. Bump = edit here + harness.json, then re-run install.",
    "methods": "npm = npm install -g --prefix <prefix> (bins land in <prefix>/bin). pip-venv = uv venv + uv pip install (uv brings its own Python). binary = pinned download + sha256 check. archive = pinned tarball, extract, link bins. script = vendor install script run non-interactively, then the binary is linked into <prefix>/bin. system = OS package (apt as root on images, brew on Mac); never sudo. unsupported = no installer exists yet; the installer reports no_installer instead of a guide link.",
    "terms": "terms.required tools install only with --accept-terms <id> (or a prior recorded acceptance at the same pin). Acceptance is stored in <prefix>/accepted-terms.json and re-asked when the pin changes.",
    "conflicts_resolved": {
      "pi": "@earendil-works/pi-coding-agent (current publisher; @mariozechner/* is the older scope, last 0.73.1). pi-mcp-adapter pinned to 4.0.0.",
      "dsh": "pip-venv (deepseek-harness-sdk + deepseek-harness-runtime-bin). The npm package `deepseek-harness` (0.0.1) is an unrelated placeholder.",
      "agy": "Vendor script on both Mac and Linux with --dir <prefix>/bin (no brew cask: a cask writes /Applications and needs the GUI app, the script installs only the CLI, user-writable).",
      "gemini": "Added: npm @google/gemini-cli@0.62.0 (Apache-2.0).",
      "unpinned": "copilot, reasonix, dim, mcode, qwenpaw, openclaw now pinned; Trae CLI has no public package (npm traecli is 404) and DevEco has no installer -> method unsupported."
    }
  },
  "tools": [
    {
      "id": "node", "name": "Node.js 22 LTS + npm", "category": "base", "bin": "node",
      "install": { "any": { "method": "archive", "version": "22.23.3",
        "url": "https://nodejs.org/dist/v{version}/node-v{version}-{os}-{arch}.tar.gz",
        "sha256Url": "https://nodejs.org/dist/v{version}/SHASUMS256.txt",
        "strip": 1, "links": { "node": "bin/node", "npm": "bin/npm", "npx": "bin/npx" } } },
      "skipIfOnPath": { "bin": "npm", "minNodeMajor": 20 },
      "verify": { "argv": ["--version"], "expect": "^v\\d+" },
      "login": { "method": "none" }, "terms": { "required": false, "license": "MIT" }, "wire": null
    },
    {
      "id": "uv", "name": "uv (Python + venvs)", "category": "base", "bin": "uv",
      "install": { "any": { "method": "script", "version": "0.12.21",
        "url": "https://astral.sh/uv/{version}/install.sh", "shell": "sh",
        "env": { "UV_INSTALL_DIR": "{bin}", "UV_NO_MODIFY_PATH": "1", "INSTALLER_NO_MODIFY_PATH": "1" },
        "binCandidates": ["{bin}/uv"] } },
      "skipIfOnPath": { "bin": "uv" },
      "verify": { "argv": ["--version"], "expect": "^uv " },
      "login": { "method": "none" }, "terms": { "required": false, "license": "Apache-2.0 OR MIT" }, "wire": null,
      "_note": "Prerequisite for pip-venv tools and for System One (Laya). The manifest guarantees uv only; Laya itself is installed by Desktop's system-one-manager (owner joe-c9)."
    },
    { "id": "git", "name": "git", "category": "base", "bin": "git", "install": { "any": { "method": "system", "apt": ["git"], "brew": ["git"] } }, "verify": { "argv": ["--version"] }, "login": { "method": "none" }, "terms": { "required": false, "license": "GPL-2.0" }, "wire": null },
