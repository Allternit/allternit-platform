{
  "name": "@allternit/docs-mcp-server",
  "version": "1.0.0",
  "description": "MCP server providing Allternit platform documentation lookup",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "allternit-docs-mcp": "dist/index.js"
  },
