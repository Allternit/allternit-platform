# AllternitOS x86_64 PC kernel (plan step 32): fragment applied over `make tinyconfig`
# with scripts/kconfig/merge_config.sh. It is the VM config (every line below the PC drivers
# marker "# ---- VM base" is x86_64-vm.config, unchanged except CONFIG_VT, which the PC needs on)
# plus real-PC drivers. mkimage.sh --target pc checks that every VM line is still here.
#
# NO MODULES. PID 1 has no module loader, so every driver is built in (=y), and the firmware
# the drivers ask for is a compressed tree in /lib/firmware: in the initramfs (built-in drivers
# probe before the system slot is mounted) and in the system slot (later loads). XZ-compressed
# blobs (xz --check=crc32) are read by CONFIG_FW_LOADER_COMPRESS_XZ. See os/image/firmware/.
# virtio stays in: the same image boots in QEMU with virtio or with emulated PC devices.
# The initramfs (CONFIG_INITRAMFS_SOURCE) is added by mkimage.sh, not here.

# ---- PC drivers
# Console on the screen: VT + framebuffer console, serial stays for CI and servers.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
CONFIG_HW_CONSOLE=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_MOUSE_PS2=y

# Graphics (KMS): firmware-booted framebuffer first (simpledrm / efifb), then native drivers.
CONFIG_I2C=y
CONFIG_MMU_NOTIFIER=y
CONFIG_ACPI_VIDEO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_I915=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y

# Storage: NVMe, SATA (AHCI), USB mass storage
CONFIG_PCI_QUIRKS=y
CONFIG_BLK_DEV_NVME=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_ACPI=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# USB: xHCI, EHCI, OHCI/UHCI (older boards), HID
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_PCI=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PCI=y
CONFIG_USB_UHCI_HCD=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y

# Wired NICs: e1000e (also QEMU's), igb, igc, r8169
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_IGC=y
CONFIG_NET_VENDOR_REALTEK=y
CONFIG_R8169=y

# Wi-Fi: Intel iwlwifi (mvm) and MediaTek mt7921e. Driver and firmware only: association
# (wpa_supplicant or iwd) is a later step, nothing in the image brings a Wi-Fi link up yet.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_INTEL=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MT76_CORE=y
CONFIG_MT7921E=y

# Firmware loading from /lib/firmware, XZ-compressed files
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# Platform: power button, CPU/PCI plumbing that real boards need
CONFIG_PM=y
CONFIG_ACPI_BUTTON=y
CONFIG_X86_X2APIC=y
CONFIG_X86_PAT=y
CONFIG_MTRR=y
CONFIG_HPET_TIMER=y
CONFIG_RANDOM_TRUST_CPU=y

# ---- VM base (x86_64-vm.config, CONFIG_VT=n removed)
# Core
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MODULES=n
CONFIG_EXPERT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RTC_CLASS=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_KERNEL_GZIP=y
CONFIG_PANIC_TIMEOUT=-1

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Power: ACPI so reboot(RB_POWER_OFF) works under QEMU q35
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# Serial console
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE_CONSOLE=y

# virtio only
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# Namespaces (model service runs in CLONE_NEWNET; user and net ns for later sandboxes)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# EFI stub so the same bzImage is the UKI payload
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_EFIVAR_FS=y
CONFIG_FW_CFG_SYSFS=n
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# Device mapper + dm-verity: PID 1 opens the active system slot (system-a / system-b)
# through dm-verity before it switches root (plan step 30a). Hash: sha256.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=n
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=n
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y

# dm-crypt for the LUKS2 state partition (plan step 30b): PID 1 loads an aes-xts-plain64
# crypt table itself (no cryptsetup in the image).
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y

# vfat ESP: the A/B boot state is /allternit/bootstate on the ESP, mounted by PID 1 at
# /run/esp (plan step 30b).
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
