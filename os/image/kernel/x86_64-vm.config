# AllternitOS x86_64 virtio-only VM kernel: fragment applied over `make tinyconfig`
# with scripts/kconfig/merge_config.sh. No modules, no real-hardware drivers.
# The initramfs (CONFIG_INITRAMFS_SOURCE) is added by mkimage.sh, not here.

# Core
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_MULTIUSER=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MODULES=n
CONFIG_EXPERT=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_AIO=y
CONFIG_FILE_LOCKING=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_SHMEM=y
CONFIG_POSIX_TIMERS=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_RTC_CLASS=n
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_KERNEL_GZIP=y
CONFIG_PANIC_TIMEOUT=-1

# initramfs
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Power: ACPI so reboot(RB_POWER_OFF) works under QEMU q35
CONFIG_ACPI=y
CONFIG_PCI=y
CONFIG_PCI_MSI=y

# Filesystems
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_SYSFS=y
CONFIG_SYSCTL=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y

# Serial console
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_VT=n

# virtio only
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_NET=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y

# Namespaces (model service runs in CLONE_NEWNET; user and net ns for later sandboxes)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# EFI stub so the same bzImage is the UKI payload
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_MIXED=n
CONFIG_EFIVAR_FS=y
CONFIG_FW_CFG_SYSFS=n
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# Device mapper + dm-verity: PID 1 opens the active system slot (system-a / system-b)
# through dm-verity before it switches root (plan step 30a). Hash: sha256.
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_FEC=n
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=n
CONFIG_CRYPTO=y
CONFIG_CRYPTO_SHA256=y

# dm-crypt for the LUKS2 state partition (plan step 30b): PID 1 loads an aes-xts-plain64
# crypt table itself (no cryptsetup in the image).
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_XTS=y

# vfat ESP: the A/B boot state is /allternit/bootstate on the ESP, mounted by PID 1 at
# /run/esp (plan step 30b).
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
