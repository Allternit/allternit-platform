{
  "name": "@allternit/office-xlsx-engine",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "xlsx import/export + IronCalc recalculation sidecar (vendored Rust crate from GenOffice apps/sheets) with a Node JSON-lines client",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./shared/desktop-api": {
      "types": "./src/shared/desktop-api.ts",
      "import": "./src/shared/desktop-api.ts",
      "default": "./src/shared/desktop-api.ts"
    },
    "./shared/*": {
      "types": "./src/shared/*.ts",
      "import": "./src/shared/*.ts",
      "default": "./src/shared/*.ts"
    },
    "./domain/*": {
      "types": "./src/domain/*.ts",
      "import": "./src/domain/*.ts",
      "default": "./src/domain/*.ts"
    },
    "./gateway/*": {
      "types": "./src/gateway/*.ts",
      "import": "./src/gateway/*.ts",
      "default": "./src/gateway/*.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "crate"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sidecar:build": "cargo build --release --manifest-path crate/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "jszip": "^3.10.1",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  },
  "author": "Allternit",
  "dependencies": {
    "@univerjs/core": "^0.25.1",
    "jszip": "^3.10.1",
    "zod": "^3.25.0"
  }
}
