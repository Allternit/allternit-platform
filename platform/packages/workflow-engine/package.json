{
  "name": "@allternit/workflow-engine",
  "version": "0.1.1",
  "description": "Allternit Workflow Engine - Visual workflow orchestration with DAG support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scheduler": {
      "import": "./dist/scheduler/index.js",
      "types": "./dist/scheduler/index.d.ts"
    },
    "./visualizer": {
      "import": "./dist/visualizer/index.js",
      "types": "./dist/visualizer/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "allternit",
    "workflow",
    "dag",
    "orchestration",
    "automation"
  ],
  "license": "MIT",
  "files": [
    "dist",
    "README.md"
  ]
}
