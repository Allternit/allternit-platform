{
  "name": "@allternit/browser-tools",
  "version": "0.1.0",
  "description": "Browser automation toolkit for Allternit agent task execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "keywords": [
    "browser",
    "automation",
    "playwright",
    "agent",
    "allternit"
  ],
  "dependencies": {
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^6.0.3",
    "vitest": "^1.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "peerDependencies": {
    "@allternit/mcp-apps-adapter": "workspace:*"
  }
}
