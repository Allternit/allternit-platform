{
  "name": "@allternit/office-file-parse",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "shared attachment parsing: pdf/docx/pptx/xlsx and plain-text formats to text; images flagged for multimodal input",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./xlsx": {
      "types": "./src/xlsx.ts",
      "import": "./src/xlsx.ts",
      "default": "./src/xlsx.ts"
    },
    "./pptx": {
      "types": "./src/pptx.ts",
      "import": "./src/pptx.ts",
      "default": "./src/pptx.ts"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@allternit/office-docx-engine": "workspace:*",
    "fast-xml-parser": "^5.3.4",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
  },
  "author": "Allternit"
}
