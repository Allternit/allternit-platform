{
  "name": "@allternit/office-suite",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Allternit Office Suite — reusable, host-agnostic Docs, Sheets, Slides, PDF, and Sign components for the platform and standalone surfaces",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./ai": {
      "import": "./src/ai/index.ts",
      "types": "./src/ai/index.ts"
    },
    "./xlsx": {
      "import": "./src/xlsx/index.ts",
      "types": "./src/xlsx/index.ts"
    },
    "./bridge": {
      "import": "./src/bridge/index.ts",
      "types": "./src/bridge/index.ts"
    }
  },
  "dependencies": {
    "@allternit/office-ai": "workspace:*",
    "@allternit/office-docs-app": "workspace:*",
    "@allternit/office-docs-editor": "workspace:*",
    "@allternit/office-pdf-app": "workspace:*",
    "@allternit/office-pdf-viewer": "workspace:*",
    "@allternit/office-sheets-app": "workspace:*",
    "@allternit/office-sheets-editor": "workspace:*",
    "@allternit/office-slides-app": "workspace:*",
    "@allternit/office-slides-editor": "workspace:*",
    "@allternit/office-xlsx-engine": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Allternit"
}
