{
  "name": "@allternit/api-client",
  "version": "1.0.2",
  "description": "Official Allternit API client for JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "vitest run --passWithNoTests"
  },
  "keywords": [
    "allternit",
    "api",
    "client",
    "sdk"
  ],
  "author": "Allternit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allternit/allternit-platform"
  },
  "homepage": "https://github.com/Allternit/allternit-platform",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
