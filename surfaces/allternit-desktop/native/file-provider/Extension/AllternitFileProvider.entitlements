<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The File Provider extension (a template: embed-file-provider.cjs fills
     __APP_GROUP__). macOS requires File Provider extensions to be sandboxed.
     No restricted entitlements, so a Developer ID or Apple Development
     signature is enough (no provisioning profile). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- cloud-api relay, and the app's loopback mesh proxies. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Computers, pins, wake prompts, transfer scratch space and the 0600
	     secrets file shared with the helper (FilesSharedStore). Team-prefixed,
	     so it needs no provisioning profile on macOS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__APP_GROUP__</string>
	</array>
</dict>
</plist>
