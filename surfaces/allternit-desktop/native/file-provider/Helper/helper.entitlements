<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- allternit-files-domains (a template: embed-file-provider.cjs fills
     __APP_GROUP__). Not sandboxed; the App Group lets it write the container
     the extension reads without macOS asking the user about another app's data. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>__APP_GROUP__</string>
	</array>
</dict>
</plist>
