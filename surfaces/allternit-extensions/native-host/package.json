{
  "name": "@allternit/desktop-native-host",
  "version": "0.1.0",
  "description": "Chrome extension ↔ Allternit Desktop native messaging bridge",
  "private": true,
  "scripts": {
    "build": "bun build --compile --target=bun native-host.ts --outfile dist/native-host",
    "doctor": "node scripts/native-host-installer.mjs --doctor",
    "register": "node scripts/native-host-installer.mjs",
    "smoke:browser-mode": "node scripts/browser-mode-smoke.mjs",
    "unregister": "node scripts/native-host-installer.mjs --uninstall",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.58.2",
    "typescript": "^6.0.3"
  }
}
