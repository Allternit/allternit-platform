<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">
  <Id>b765c354-dc5c-4b98-9f54-320e110c42d2</Id>
  <Version>1.1.3.0</Version>
  <ProviderName>Allternit</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Allternit for Excel" />
  <Description DefaultValue="Allternit analysis, modeling, and workbook tools for Microsoft Excel" />
  <IconUrl DefaultValue="https://platform.allternit.com/office-addins/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://platform.allternit.com/office-addins/icon-80.png" />
  <SupportUrl DefaultValue="https://allternit.com" />
  <AppDomains>
    <AppDomain>https://platform.allternit.com/office-addins</AppDomain>
    <AppDomain>https://platform.allternit.com</AppDomain>
    <!-- Auth bridge (displayDialogAsync target) signs in through Clerk; the
         dialog must be allowed to reach these origins. -->
    <AppDomain>https://clerk.allternit.com</AppDomain>
    <AppDomain>https://*.clerk.dev</AppDomain>
    <AppDomain>https://*.accounts.dev</AppDomain>
    <AppDomain>https://challenges.cloudflare.com</AppDomain>
    <AppDomain>http://localhost:3000</AppDomain>
    <AppDomain>http://localhost:3013</AppDomain>
  </AppDomains>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ExcelApi" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <Hosts><Host Name="Workbook" /></Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://platform.allternit.com/office-addins/src/taskpane/?product=excel" />
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Workbook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="Allternit.excel.Commands">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>
                <Control xsi:type="Button" id="Allternit.excel.Open">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Allternit.excel.Taskpane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://platform.allternit.com/office-addins/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://platform.allternit.com/office-addins/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://platform.allternit.com/office-addins/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://platform.allternit.com/office-addins/src/taskpane/?product=excel" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://platform.allternit.com/office-addins/src/taskpane/?product=excel" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label" DefaultValue="Allternit for Excel" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Open Allternit" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Open Allternit for Excel" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
