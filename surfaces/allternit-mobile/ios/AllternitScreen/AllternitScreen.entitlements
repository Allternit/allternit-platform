<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Broadcast state (heartbeat, watched) shared with the app's banner. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.allternit.mobile</string>
	</array>
	<!-- App phone credentials written by the app's pairing screen. Only the
	     shared group: the extension never sees Clerk's items. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allternit.mobile.shared</string>
	</array>
</dict>
</plist>
