<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<!-- Clerk iOS SDK requires the Frontend API URL as a webcredentials
		     associated domain for seamless OAuth / Sign in with Apple hand-off.
		     https://clerk.com/docs/ios/getting-started/quickstart -->
		<string>webcredentials:clerk.allternit.com</string>
	</array>
	<!-- Clerk iOS SDK persists client/session state in the keychain; without
	     this group the writes fail with errSecMissingEntitlement (-34018) and
	     every subsequent API call goes out unauthenticated ("signed_out" 401). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allternit.mobile</string>
		<!-- Second, so it is NOT the default group Clerk writes to: only the
		     app phone credentials go here, shared with AllternitScreen. -->
		<string>$(AppIdentifierPrefix)com.allternit.mobile.shared</string>
	</array>
	<!-- Broadcast state shared with the AllternitScreen extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.allternit.mobile</string>
	</array>
</dict>
</plist>
