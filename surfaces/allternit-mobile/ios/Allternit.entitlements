<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:clerk.allternit.com</string>
		<string>applinks:m.allternit.com</string>
		<string>applinks:ai.allternit.com</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allternit.mobile</string>
		<!-- Second, so it is NOT the default group Clerk writes to: only the
		     app phone credentials go here, shared with AllternitScreen. -->
		<string>$(AppIdentifierPrefix)com.allternit.mobile.shared</string>
	</array>
	<!-- Broadcast state shared with the AllternitScreen extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.allternit.mobile</string>
	</array>
</dict>
</plist>
