<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:clerk.allternit.com</string>
		<string>applinks:m.allternit.com</string>
		<string>applinks:ai.allternit.com</string>
	</array>
	<!-- System surfaces: approval pushes break through Focus, and bot
	     messages show as communication notifications (sender avatar). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.developer.usernotifications.communication</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allternit.mobile</string>
		<!-- Second, so it is NOT the default group Clerk writes to: only the
		     app phone credentials go here, shared with AllternitScreen. -->
		<string>$(AppIdentifierPrefix)com.allternit.mobile.shared</string>
	</array>
	<!-- Shared with AllternitScreen (broadcast state) and the widget,
	     notification and share extensions (SystemSurfaces/AppGroup.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.allternit.mobile</string>
	</array>
	<!-- On-device models (Core/OnDevice): NOT enabled. The production App
	     ID does not have the Increased Memory Limit capability (Eoj decision
	     + App Review note pending, spec/on-device/ios-memory-spike.md).
	     Turning this on with automatic signing would register it on the
	     production App ID, so leave it commented until that is approved.
	     The runtime measures os_proc_available_memory() at run time and
	     works without it (iPhone 15: 3,063 MB -> 2.24 GB budget); with it
	     the same code reads ~4,088 MB -> 2.99 GB, no other change needed.
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
	-->
</dict>
</plist>
