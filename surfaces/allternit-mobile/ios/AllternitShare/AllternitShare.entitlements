<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- State shared with the app (SystemSurfaces/AppGroup.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.allternit.mobile</string>
	</array>
	<!-- Only the shared group: extensions never see Clerk's items. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.allternit.mobile.shared</string>
	</array>
</dict>
</plist>
