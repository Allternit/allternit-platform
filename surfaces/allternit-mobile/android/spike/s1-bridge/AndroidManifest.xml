<?xml version="1.0" encoding="utf-8"?>
<!-- SPIKE S1 (Android bridge), DEBUG BUILDS ONLY.
     Wired in app/build.gradle.kts as the "debug" source set manifest, so it is
     merged into phonelinkDebug and playDebug and never into any release build.
     See spike/s1-bridge/README.md and spec/on-device/android-bridge-spike.md. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The localhost server (candidate 2 + the offline test page) runs in a
         foreground service, like the W9 engine would. No runtime prompt: the
         spike never asks for POST_NOTIFICATIONS, so on Android 13+ the service
         notification may simply be hidden. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application>

        <!-- Second launcher icon, debug builds only: "S1 bridge". Starts the
             service, opens the TWA with our own CustomTabsSession, finishes. -->
        <activity
            android:name="com.allternit.app.spike.s1.S1BridgeActivity"
            android:exported="true"
            android:label="S1 bridge"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required by the TWA postMessage API: Chrome binds to it to deliver
             page -> app messages and the channel-ready signal. -->
        <service
            android:name="androidx.browser.customtabs.PostMessageService"
            android:exported="true" />

        <service
            android:name="com.allternit.app.spike.s1.S1Service"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Debug-only spike: local bridge test server" />
        </service>

        <!-- adb-only controls: android.permission.DUMP is held by the adb shell
             and system, not by apps. -->
        <receiver
            android:name="com.allternit.app.spike.s1.S1CommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.allternit.app.s1.REQUEST_CHANNEL" />
                <action android:name="com.allternit.app.s1.STATUS" />
                <action android:name="com.allternit.app.s1.DAL_DROP" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
