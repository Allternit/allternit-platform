<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shared by both builds: m.allternit.com as a Trusted Web Activity. The
         screen-share lane (src/phoneshare: share screen, MediaProjection
         capture, the accessibility service for a viewer's taps) is declared in
         each flavor's manifest (src/play, src/phonelink). The rest of Phone
         Link (local server, mesh library, adb shell server, its services,
         receivers and permissions) lives in src/phonelink and ships only in
         the sideloaded build that Allternit Desktop installs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: Web Push shows under Allternit (notification delegation), so
         the app needs the runtime notification permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Files drive: the upload retry job waits for a network (JobScheduler), and
         protected roots (Memory Drive) ask for a fresh fingerprint/face/screen-lock
         unlock (BiometricPrompt, framework API, no androidx dependency). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:targetApi="35">

        <!-- Digital Asset Links back to m.allternit.com (its assetlinks.json names
             this app ID and the release cert), so Chrome shows the site full-screen. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- The Allternit app: m.allternit.com as a Trusted Web Activity. Without
             a TWA-capable browser it opens as a Custom Tab instead.
             ${launcherActivity} is set per flavor in app/build.gradle.kts:
             phonelink = androidbrowserhelper's LauncherActivity; play =
             com.allternit.app.ReviewLauncherActivity (same launcher, plus the
             Play in-app review prompt). -->
        <activity
            android:name="${launcherActivity}"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://m.allternit.com/" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/twa_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/twa_bar" />
            <!-- Long-press shortcuts (Ask a bot, Hand off a task, Needs you, Call main bot). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Share target: androidbrowserhelper parses this JSON (SharingUtils) and
                 opens m.allternit.com/share-target?title=..&text=.. (GET, text only). -->
            <meta-data
                android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                android:value="@string/share_target" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- priority -1: the one m.allternit.com path this app handles natively
                 (/files/android-callback, FilesSignInActivity below, priority 0) wins
                 without a chooser between two of our own activities. Every other
                 m.allternit.com link still only matches this filter. -->
            <intent-filter android:autoVerify="true" android:priority="-1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="m.allternit.com" />
            </intent-filter>
        </activity>

        <!-- ============ Files drive (SPEC contracts/files-drive, both flavors) ============
             Every Allternit computer as a location in the system file picker and Files app
             (design 7B: one root per computer), "Save to computer" in the share sheet
             (design 7C), the wake prompt, the protected-root unlock and the sign-in hand-off.
             Sources: java/com/allternit/app/files/. Own task affinity, so these screens
             never stack on top of the TWA's task. -->
        <provider
            android:name="com.allternit.app.files.AllternitDocumentsProvider"
            android:authorities="${applicationId}.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Sign-in: Custom Tab to m.allternit.com/files/connect-android, back here through
             the verified App Link /files/android-callback with a token sealed to this
             phone's Keystore key. allternit-files://signin is the same hand-off for a build
             whose App Link is not verified (debug builds, signing key not in assetlinks):
             the sealed token opens only with this phone's key either way. -->
        <activity
            android:name="com.allternit.app.files.FilesSignInActivity"
            android:exported="true"
            android:label="@string/files_label"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.AllternitFiles">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="m.allternit.com"
                    android:path="/files/android-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="allternit-files" android:host="signin" />
            </intent-filter>
            <!-- "Settings" on an Allternit computer in the Files app: which computers
                 show, sign out. The intent carries the document's content URI and type. -->
            <intent-filter>
                <action android:name="android.provider.action.DOCUMENT_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="${applicationId}.files"
                    android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Share sheet: "Save to computer" for any file, several files, or text. -->
        <activity
            android:name="com.allternit.app.files.ShareToComputerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/files_share_label"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.AllternitFiles">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Agent tasks waiting in a computer's Inbox: Approve / Reject. Opened from the share screen. -->
        <activity
            android:name="com.allternit.app.files.InboxActivity"
            android:exported="false"
            android:label="Inbox tasks"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.AllternitFiles" />

        <!-- Files key (approve devices, give computers the key). Opened from Files settings. -->
        <activity
            android:name="com.allternit.app.files.FilesKeyActivity"
            android:exported="false"
            android:label="Files key"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.AllternitFiles" />
        <!-- Opened only from our own notification / provider PendingIntents. -->
        <activity
            android:name="com.allternit.app.files.WakePromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.files"
            android:theme="@style/Theme.AllternitFiles.Dialog" />
        <activity
            android:name="com.allternit.app.files.UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.files"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Retries queued uploads when the network is back. -->
        <service
            android:name="com.allternit.app.files.FilesUploadJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Notification delegation: Chrome hands Web Push to this service, so
             notifications (and their action buttons) appear under Allternit. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Asks for POST_NOTIFICATIONS on Android 13+ when the site requests
             notification permission (started via a PendingIntent from DelegationService). -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>
</manifest>
