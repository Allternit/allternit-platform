<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Shared by both builds. The Google Play build ("play" flavor) is only
         this: m.allternit.com as a Trusted Web Activity. Phone Link (its code,
         the mesh library, the accessibility service, services, receivers and
         permissions) lives in src/phonelink and ships only in the sideloaded
         build that Allternit Desktop installs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: Web Push shows under Allternit (notification delegation), so
         the app needs the runtime notification permission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        tools:targetApi="35">

        <!-- Digital Asset Links back to m.allternit.com (its assetlinks.json names
             this app ID and the release cert), so Chrome shows the site full-screen. -->
        <meta-data
            android:name="asset_statements"
            android:resource="@string/asset_statements" />

        <!-- The Allternit app: m.allternit.com as a Trusted Web Activity. Without
             a TWA-capable browser it opens as a Custom Tab instead. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="https://m.allternit.com/" />
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/twa_bar" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/twa_bar" />
            <!-- Long-press shortcuts (Ask a bot, Hand off a task, Needs you, Call main bot). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <!-- Share target: androidbrowserhelper parses this JSON (SharingUtils) and
                 opens m.allternit.com/share-target?title=..&text=.. (GET, text only). -->
            <meta-data
                android:name="android.support.customtabs.trusted.METADATA_SHARE_TARGET"
                android:value="@string/share_target" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="m.allternit.com" />
            </intent-filter>
        </activity>

        <!-- Notification delegation: Chrome hands Web Push to this service, so
             notifications (and their action buttons) appear under Allternit. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Asks for POST_NOTIFICATIONS on Android 13+ when the site requests
             notification permission (started via a PendingIntent from DelegationService). -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

    </application>
</manifest>
