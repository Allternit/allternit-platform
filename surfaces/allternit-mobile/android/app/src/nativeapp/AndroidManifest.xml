<?xml version="1.0" encoding="utf-8"?>
<!-- The nativeapp flavor (step 7b): the native MainActivity is the app icon. The TWA
     LauncherActivity from src/main keeps its other filters but not LAUNCHER (see
     ${twaLauncherCategory} in app/build.gradle.kts). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="com.allternit.feature.shell.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- TWA → native sign-in hand-off (feature/shell TwaHandoff.kt): the page at
                 m.allternit.com/auth/android-handoff returns the sealed sign-in token to this
                 App Link (priority 0 beats the TWA's catch-all m.allternit.com filter at -1),
                 or to the custom scheme when the App Link is not verified (debug signing).
                 The token opens only with this phone's Keystore key either way. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="m.allternit.com"
                    android:path="/auth/android-callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="allternit-auth" android:host="handoff" />
            </intent-filter>
        </activity>
    </application>
</manifest>
