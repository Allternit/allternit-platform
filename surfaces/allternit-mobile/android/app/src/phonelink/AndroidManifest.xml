<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Phone Link: merged on top of src/main for the "phonelink" flavor only
         (the sideloaded build). The "play" flavor never sees this file. -->
    <!-- The mesh refreshes its interface list when the default network changes. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- terminate_app (best effort): killBackgroundProcesses. Normal permission. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Live screen (ShellServerLauncher): turn wireless debugging on after a
         reboot to start the shell server. A development permission: only
         `adb shell pm grant` (cable setup) can grant it. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: launchable apps (list_apps, launch_app,
         and through them custom-scheme deep links) and browsers for open_url. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <!-- Adds the "Phone Link" long-press shortcut to the shared launcher. -->
        <activity android:name="com.google.androidbrowserhelper.trusted.LauncherActivity">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Phone Link status (sessions, Stop/Start, Revoke): opened from its
             notification and from the "Phone Link" shortcut on the app icon. -->
        <activity
            android:name="com.allternit.phonelink.MainActivity"
            android:exported="true"
            android:label="@string/phone_link_label"
            android:launchMode="singleTop" />

        <!-- The hands and eyes. Enabled over adb with
             settings put secure enabled_accessibility_services com.allternit.app/com.allternit.phonelink.PhoneLinkAccessibilityService -->
        <service
            android:name="com.allternit.phonelink.PhoneLinkAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Hosts the persistent notification. Exported only to DUMP holders (adb shell,
             system) so `am start-foreground-service` works from the cable. -->
        <service
            android:name="com.allternit.phonelink.PhoneLinkService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.DUMP">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local server that lets the user's own paired computer operate apps on this phone through the accessibility service; the user starts and stops it." />
        </service>

        <!-- Runs the gomobile tsnet node in a private process so a Go panic
             there can never take down the phone server. Same-uid binding
             only (exported=false); the main process supplies start inputs in
             the bind Intent and receives reports on a Messenger. -->
        <service
            android:name="com.allternit.phonelink.MeshService"
            android:exported="false"
            android:process=":mesh" />

        <receiver
            android:name="com.allternit.phonelink.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- One-time cable setup. Only senders holding DUMP (adb shell, system) can reach it. -->
        <receiver
            android:name="com.allternit.phonelink.ProvisionReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.allternit.phonelink.PROVISION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.allternit.phonelink.StopReceiver"
            android:exported="false" />

        <receiver
            android:name="com.allternit.phonelink.PairingActionReceiver"
            android:exported="false" />
    </application>
</manifest>
