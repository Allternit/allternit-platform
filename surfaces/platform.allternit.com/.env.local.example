# Copy to .env.local and fill in the Clerk publishable key from the dashboard.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_YOUR_KEY_HERE
VITE_ALLTERNIT_GATEWAY_URL=https://api.allternit.com
VITE_ALLTERNIT_CLOUD_API_URL=https://api.allternit.com

# AllternitOS control plane URL for the Fabric console page. Leave unset in
# production: Fabric then shows an unavailable state and makes no request.
# For local development use http://127.0.0.1:8080.
# VITE_ALLTERNITOS_URL=http://127.0.0.1:8080

# ACU gateway for credential testing. Leave unset in production.
# VITE_ACU_GATEWAY_URL=http://127.0.0.1:8760

# Per-key and org IP allowlists (off until the API origin passes a trusted client IP)
# VITE_KEY_IP_ALLOWLIST=1
# Clerk SSO/SCIM panel on Security (needs the Clerk plan)
# VITE_ORG_SSO=1

# Per-project body logging toggle for Logs replay (server also needs PLATFORM_LOG_BODIES=1)
# VITE_LOG_BODIES=1
