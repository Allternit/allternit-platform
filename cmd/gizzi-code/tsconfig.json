{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "node"
    ],
    "noUncheckedIndexedAccess": false,
    "strict": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@/ink": [
        "./src/cli/ui/ink-app/ink.ts"
      ],
      "@/ink.js": [
        "./src/cli/ui/ink-app/ink.ts"
      ],
      "@/ink/*": [
        "./src/cli/ui/ink-app/ink/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "src/*": [
        "./src/*",
        "./src/cli/ui/ink-app/*"
      ],
      "@tui/*": [
        "./src/cli/ui/tui/*"
      ],
      "@/commands/*": [
        "./src/cli/ui/ink-app/commands/*",
        "./src/commands/*",
        "./src/runtime/commands/*"
      ],
      "@/services/*": [
        "./src/cli/ui/ink-app/services/*",
        "./src/services/*",
        "./src/runtime/services/*"
      ],
      "@/hooks/*": [
        "./src/cli/ui/ink-app/hooks/*",
        "./src/hooks/*",
        "./src/runtime/hooks/*"
      ],
      "@/utils/*": [
        "./src/cli/ui/ink-app/utils/*",
        "./src/utils/*",
        "./src/runtime/utils/*"
      ],
      "@/types/*": [
        "./src/cli/ui/ink-app/types/*",
        "./src/types/*",
        "./src/runtime/types/*"
      ],
      "@/components/*": [
        "./src/cli/ui/ink-app/components/*",
        "./src/components/*"
      ],
      "@/state/*": [
        "./src/cli/ui/ink-app/state/*",
        "./src/state/*",
        "./src/runtime/state/*"
      ],
      "@/bootstrap/*": [
        "./src/cli/ui/ink-app/bootstrap/*",
        "./src/bootstrap/*"
      ],
      "@/tools/*": [
        "./src/cli/ui/ink-app/tools/*",
        "./src/tools/*",
        "./src/runtime/tools/*"
      ],
      "@/constants/*": [
        "./src/cli/ui/ink-app/constants/*",
        "./src/constants/*"
      ],
      "@/core/*": [
        "./src/cli/ui/ink-app/core/*",
        "./src/core/*"
      ],
      "@/runtime/*": [
        "./src/cli/ui/ink-app/runtime/*",
        "./src/runtime/*"
      ],
      "@/entrypoints/*": [
        "./src/cli/ui/ink-app/entrypoints/*",
        "./src/entrypoints/*"
      ],
      "@allternit/util": [
        "../../platform/packages/util/src"
      ],
      "@allternit/remote-control": [
        "./packages/remote-control/src/index"
      ],
      "@allternit/remote-control/*": [
        "./packages/remote-control/src/*"
      ],
      "@allternit/gizzi-sdk": [
        "./packages/sdk/src"
      ],
      "@allternit/gizzi-sdk/*": [
        "./packages/sdk/src/*"
      ],
      "@allternit/gizzi-sdk/providers/allternit/error": [
        "./packages/sdk/src/providers/allternit/error.ts"
      ],
      "@allternit/gizzi-sdk/providers/allternit/streaming.mjs": [
        "./packages/sdk/src/providers/allternit/streaming.ts"
      ],
      "@allternit/gizzi-sdk/providers/allternit/resources/index.mjs": [
        "./packages/sdk/src/providers/allternit/resources/index.ts"
      ],
      "@allternit/gizzi-sdk/providers/allternit/resources/messages.mjs": [
        "./packages/sdk/src/providers/allternit/resources/messages/index.ts"
      ],
      "@allternit/gizzi-sdk/providers/allternit/resources/beta/messages/messages.mjs": [
        "./packages/sdk/src/providers/allternit/resources/beta/messages/index.ts"
      ],
      "@allternit/sdk": [
        "./packages/sdk/src"
      ],
      "@allternit/sdk/*": [
        "./packages/sdk/src/*"
      ]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "github/**/*",
    "packages/**/*",
    "sdks/**/*",
    "shared/**/*",
    "script/**/*"
  ],
  "exclude": [
    "dist",
    "infra",
    "node_modules",
    "output",
    "migration",
    "packages/sdk/dist"
  ]
}