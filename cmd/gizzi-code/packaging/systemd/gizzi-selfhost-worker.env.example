# /etc/allternit/gizzi-selfhost-worker.env (mode 0600) for gizzi-selfhost-worker.service.
# Your Agents Server. https:// unless the worker reaches it on a private network.
ALLTERNIT_SERVER_URL=https://agents.example.internal:8400
# The environment this worker serves, and its environment key (aek_...).
# Make the key with: allternit-agents-server admin env-keys create <environment id>
ALLTERNIT_ENVIRONMENT_ID=env_0123456789abcdef
ALLTERNIT_ENVIRONMENT_KEY=aek_replace_me
# Optional: a stable name shown in `gizzi runtime status` (default host-pid).
#ALLTERNIT_WORKER_ID=worker-1
