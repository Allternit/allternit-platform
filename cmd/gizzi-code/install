#!/usr/bin/env bash
# SOURCE OF TRUTH: cmd/gizzi-code/install in the Allternit/allternit-platform
# repo — edit there and copy. The copy served from
# https://install.gizziio.com/install must stay byte-identical to this file.
# cli-package/install/install.sh is a thin redirect to this script.
set -euo pipefail
APP=gizzi-code

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Gizzi Code Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 1.0.180)
                            Default: version from the signed release feed for
                            GIZZI_CHANNEL (stable or latest; default stable)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)

Examples:
    curl -fsSL https://install.gizziio.com/install | bash
    curl -fsSL https://install.gizziio.com/install | bash -s -- --version 1.0.180
    ./install --binary /path/to/gizzi-code
EOF
}

requested_version=${GIZZI_VERSION:-${VERSION:-}}
no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=${INSTALL_DIR:-$HOME/.gizzi/bin}
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    archive_ext=".zip"
    if [ "$os" = "linux" ] || [ "$os" = "darwin" ]; then
      archive_ext=".tar.gz"
    fi

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    filename="$APP-$target$archive_ext"


    if [ "$os" = "linux" ] || [ "$os" = "darwin" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    fi
    if [ "$os" = "windows" ]; then
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    url_ok() {
        [ "$(curl -sI -o /dev/null -w "%{http_code}" -L "$1")" = "200" ]
    }

    release_exists() {
        local v="$1"
        url_ok "$base/tag/gizzi-code/v${v}" || url_ok "$base/tag/gizzi-code/${v}"
    }

    resolve_download_url() {
        local asset_name="$1"
        local ver="$2"
        local u
        for tag in "gizzi-code/v${ver}" "gizzi-code/${ver}"; do
            u="$base/download/${tag}/${asset_name}"
            if url_ok "$u"; then
                echo "$u"
                return 0
            fi
        done
        return 1
    }

    base="https://github.com/Allternit/allternit-platform/releases"
    api="https://api.github.com/repos/Allternit/allternit-platform"
    feed_base="${GIZZI_FEED_URL:-https://runtime.allternit.com/gizzi}"
    channel="${GIZZI_CHANNEL:-stable}"
    case "$channel" in
        stable|latest) ;;
        *)
            echo -e "${RED}Error: GIZZI_CHANNEL must be 'stable' or 'latest' (got '${channel}')${NC}"
            exit 1
            ;;
    esac

    # Public key for the Allternit-signed release feed (Ed25519).
    FEED_PUBLIC_KEY='-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEALAlANLp9v9/gNgi58OKl5N2X2MfeSD4cRGs+ONKmUYQ=
-----END PUBLIC KEY-----'

    # Pull fields out of the flattened feed JSON (no jq needed).
    feed_version() {
        printf '%s' "$1" | tr -d '\n\r' | sed -n 's/.*"version" *: *"\([^"]*\)".*/\1/p'
    }
    feed_paused() {
        printf '%s' "$1" | tr -d '\n\r' | grep -Eq '"paused" *: *true'
    }
    feed_artifact_field() { # <json> <platform-key> <url|sha256>
        local obj
        obj=$(printf '%s' "$1" | tr -d '\n\r' | sed -n "s/.*\"$2\" *: *{\([^}]*\)}.*/\1/p")
        printf '%s' "$obj" | sed -n "s/.*\"$3\" *: *\"\([^\"]*\)\".*/\1/p"
    }

    # Check latest.json.sig (base64 Ed25519 over the exact feed bytes).
    # Returns 0 = verified, 1 = bad signature, 2 = cannot check here.
    verify_feed_signature() {
        local feed_file="$1" sig_file="$2" work out
        command -v openssl >/dev/null 2>&1 || return 2
        work=$(mktemp -d "${TMPDIR:-/tmp}/gizzi_sig_XXXXXX")
        printf '%s\n' "$FEED_PUBLIC_KEY" > "$work/pub.pem"
        if ! openssl base64 -d -A -in "$sig_file" -out "$work/sig.bin" 2>/dev/null; then
            rm -rf "$work"; return 1
        fi
        out=$(openssl pkeyutl -verify -pubin -inkey "$work/pub.pem" -rawin \
            -in "$feed_file" -sigfile "$work/sig.bin" 2>&1 || true)
        rm -rf "$work"
        case "$out" in
            *"Signature Verified Successfully"*) return 0 ;;
            *"Signature Verification Failure"*) return 1 ;;
            *) return 2 ;;
        esac
    }

    # --- 1. Try the signed feed ---
    feed_json=""
    feed_ver=""
    feed_dir=$(mktemp -d "${TMPDIR:-/tmp}/gizzi_feed_XXXXXX")
    if curl -fsSL --max-time 20 -o "$feed_dir/latest.json" "$feed_base/$channel/latest.json" 2>/dev/null; then
        sig_state=2
        if curl -fsSL --max-time 20 -o "$feed_dir/latest.json.sig" "$feed_base/$channel/latest.json.sig" 2>/dev/null; then
            verify_feed_signature "$feed_dir/latest.json" "$feed_dir/latest.json.sig" && sig_state=0 || sig_state=$?
        fi
        if [ "$sig_state" = "1" ]; then
            echo -e "${RED}Error: release feed signature is invalid; refusing to use it${NC}" >&2
        else
            feed_json=$(cat "$feed_dir/latest.json")
            feed_ver=$(feed_version "$feed_json")
            if [ -z "$feed_ver" ]; then
                feed_json=""
            elif [ "$sig_state" = "2" ]; then
                echo -e "${MUTED}Feed signature not checked on this machine (Ed25519 verify unavailable); relying on sha256 from the HTTPS feed${NC}" >&2
            fi
        fi
    fi
    rm -rf "$feed_dir"

    if [ -n "$feed_json" ] && feed_paused "$feed_json" && [ -z "$requested_version" ]; then
        echo -e "${RED}Error: the ${channel} channel is paused; nothing to install right now.${NC}"
        echo -e "${MUTED}Install a specific version with --version <version> if you need one.${NC}"
        exit 1
    fi

    if [ -z "$requested_version" ]; then
        if [ -n "$feed_ver" ]; then
            specific_version="$feed_ver"
        else
            echo -e "${ORANGE}Release feed unreachable; falling back to GitHub release tags (gizzi-code/v*)${NC}" >&2
            tag=$(curl -fsSL "$api/releases?per_page=100" 2>/dev/null \
                | grep -o '"tag_name": *"gizzi-code/v[^"]*"' \
                | head -n1 | sed 's/.*"gizzi-code\/v\([^"]*\)"/\1/' || true)
            if [ -z "$tag" ]; then
                echo -e "${RED}Failed to fetch version information${NC}"
                exit 1
            fi
            specific_version="$tag"
        fi
    else
        # Accept "0.2.3", "v0.2.3", or "gizzi-code/0.2.3"
        requested_version="${requested_version#gizzi-code/}"
        requested_version="${requested_version#v}"
        specific_version=$requested_version
    fi

    # --- 2. Pick the artifact and its expected sha256 ---
    url=""
    expected_sha=""
    print_source=""
    feed_os="$os"
    [ "$os" = "windows" ] && feed_os="win32"
    # The feed lists only the plain builds; baseline and musl builds come from the tag.
    if [ -n "$feed_json" ] && [ "$feed_ver" = "$specific_version" ] \
        && [ "$needs_baseline" != "true" ] && [ "$is_musl" != "true" ]; then
        f_url=$(feed_artifact_field "$feed_json" "$feed_os-$arch" url)
        f_sha=$(feed_artifact_field "$feed_json" "$feed_os-$arch" sha256)
        if [ -n "$f_url" ] && [ -n "$f_sha" ]; then
            url="$f_url"
            expected_sha=$(echo "$f_sha" | tr '[:upper:]' '[:lower:]')
            asset="${f_url##*/}"
            print_source="signed release feed, ${channel}"
        else
            echo -e "${MUTED}No ${feed_os}-${arch} build in the feed; using the GitHub release tag${NC}" >&2
        fi
    fi

    if [ -z "$url" ]; then
        # Tag path: the release must exist, and checksums.txt from that release is required.
        if ! release_exists "$specific_version"; then
            echo -e "${RED}Error: Release ${specific_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/Allternit/allternit-platform/releases${NC}"
            exit 1
        fi
        asset="gizzi-code-v${specific_version}-$target$archive_ext"
        if ! url="$(resolve_download_url "$asset" "$specific_version")"; then
            asset="$APP-$target$archive_ext"
            if ! url="$(resolve_download_url "$asset" "$specific_version")"; then
                echo -e "${RED}Error: asset gizzi-code-v${specific_version}-$target$archive_ext not found for ${specific_version}${NC}"
                echo -e "${MUTED}Available releases: https://github.com/Allternit/allternit-platform/releases${NC}"
                exit 1
            fi
        fi
        checksums_url=""
        for t in "gizzi-code/v${specific_version}" "gizzi-code/${specific_version}"; do
            candidate="$base/download/${t}/checksums.txt"
            if url_ok "$candidate"; then checksums_url="$candidate"; break; fi
        done
        if [ -z "$checksums_url" ]; then
            echo -e "${RED}Error: checksums.txt not found for ${specific_version}; refusing to install an unverified download${NC}"
            exit 1
        fi
        expected_sha=$(curl -fsSL "$checksums_url" | grep -E " \*?${asset}\$|^${asset} " | awk '{print $1}' | head -n1 | tr -d '\r' | tr '[:upper:]' '[:lower:]')
        if [ -z "$expected_sha" ]; then
            echo -e "${RED}Error: ${asset} is not listed in checksums.txt; refusing to install an unverified download${NC}"
            exit 1
        fi
        print_source="GitHub release gizzi-code/v${specific_version}"
    fi
    filename="$asset"
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v gizzi-code >/dev/null 2>&1; then
        gizzi_path=$(which gizzi-code)

        ## Check the installed version
        installed_version=$(gizzi-code --version 2>/dev/null || echo "")

        if [[ "$installed_version" != "$specific_version" ]]; then
            print_message info "${MUTED}Installed version: ${NC}$installed_version."
        else
            print_message info "${MUTED}Version ${NC}$specific_version${MUTED} already installed"
            exit 0
        fi
    fi
}

unbuffered_sed() {
    if echo | sed -u -e "" >/dev/null 2>&1; then
        sed -nu "$@"
    elif echo | sed -l -e "" >/dev/null 2>&1; then
        sed -nl "$@"
    else
        local pad="$(printf "\n%512s" "")"
        sed -ne "s/$/\\${pad}/" "$@"
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    local tmp_dir=${TMPDIR:-/tmp}
    local basename="${tmp_dir}/allternit_install_$$"
    local tracefile="${basename}.trace"

    rm -f "$tracefile"
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$tracefile\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    (
        curl --trace-ascii "$tracefile" -s -L -o "$output" "$url"
    ) &
    local curl_pid=$!

    unbuffered_sed \
        -e 'y/ACDEGHLNORTV/acdeghlnortv/' \
        -e '/^0000: content-length:/p' \
        -e '/^<= recv data/p' \
        "$tracefile" | \
    {
        local length=0
        local bytes=0

        while IFS=" " read -r -a line; do
            [ "${#line[@]}" -lt 2 ] && continue
            local tag="${line[0]} ${line[1]}"

            if [ "$tag" = "0000: content-length:" ]; then
                length="${line[2]}"
                length=$(echo "$length" | tr -d '\r')
                bytes=0
            elif [ "$tag" = "<= recv" ]; then
                local size="${line[3]}"
                bytes=$(( bytes + size ))
                if [ "$length" -gt 0 ]; then
                    print_progress "$bytes" "$length"
                fi
            fi
        done
    }

    wait $curl_pid
    local ret=$?
    echo "" >&4
    return $ret
}

sha256_of() {
    if command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v openssl >/dev/null 2>&1; then
        openssl dgst -sha256 "$1" | awk '{print $NF}'
    else
        echo -e "${RED}Error: no sha256 tool found (need shasum, sha256sum or openssl)${NC}" >&2
        exit 1
    fi
}

verify_checksum() {
    # No flag or environment variable skips this check.
    local file="$1" actual
    actual=$(sha256_of "$file")
    if [ -z "${expected_sha:-}" ] || [ "$actual" != "$expected_sha" ]; then
        echo -e "${RED}Error: sha256 mismatch for ${asset}${NC}" >&2
        echo -e "${RED}Expected: ${expected_sha:-<none>}${NC}" >&2
        echo -e "${RED}Actual:   ${actual}${NC}" >&2
        rm -rf "$(dirname "$file")"
        exit 1
    fi
    print_message info "${MUTED}Verified sha256: ${NC}$actual"
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}gizzi-code ${MUTED}version: ${NC}$specific_version ${MUTED}(${print_source})${NC}"
    local tmp_dir="${TMPDIR:-/tmp}/gizzi_install_$$"
    mkdir -p "$tmp_dir"

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        curl -# -fL -o "$tmp_dir/$filename" "$url"
    fi

    verify_checksum "$tmp_dir/$filename"

    if [ "$os" = "linux" ] || [ "$os" = "darwin" ]; then
        tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    else
        unzip -q "$tmp_dir/$filename" -d "$tmp_dir"
    fi

    # The archive contains a binary named "gizzi-code"; install it as
    # "gizzi-code" with a "gizzi" alias/symlink.
    mv "$tmp_dir/gizzi-code" "$INSTALL_DIR/gizzi-code"
    chmod 755 "${INSTALL_DIR}/gizzi-code"
    ln -sf "gizzi-code" "${INSTALL_DIR}/gizzi"
    # Helpers gizzi finds next to itself: the Factory engine (gizzi agents …)
    # and the Files drive mount helper (gizzi files mount, big uploads).
    for helper in allternit-factory allternit-files-mount; do
        if [ -f "$tmp_dir/$helper" ]; then
            mv "$tmp_dir/$helper" "$INSTALL_DIR/$helper"
            chmod 755 "${INSTALL_DIR}/$helper"
        fi
    done
    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}gizzi-code ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/gizzi-code"
    chmod 755 "${INSTALL_DIR}/gizzi-code"
    ln -sf "gizzi-code" "${INSTALL_DIR}/gizzi"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi


add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fqx "$command" "$config_file" || grep -Fqx "# gizzi-code begin" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        # Write between begin/end markers so the uninstaller can remove
        # EXACTLY this block and nothing else. Do not write unmarked lines.
        printf '\n# gizzi-code begin\n%s\n# gizzi-code end\n' "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}gizzi-code ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

echo -e ""
echo -e "${MUTED}                    ${NC}             ▄     "
echo -e "${MUTED}█▀▀█ █▀▀█ █▀▀█ █▀▀▄ ${NC}█▀▀▀ █▀▀█ █▀▀█ █▀▀█"
echo -e "${MUTED}█░░█ █░░█ █▀▀▀ █░░█ ${NC}█░░░ █░░█ █░░█ █▀▀▀"
echo -e "${MUTED}▀▀▀▀ █▀▀▀ ▀▀▀▀ ▀  ▀ ${NC}▀▀▀▀ ▀▀▀▀ ▀▀▀▀ ▀▀▀▀"
echo -e ""
echo -e ""
echo -e "${MUTED}Gizzi Code - AI-powered terminal interface${NC}"
echo -e ""
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "gizzi-code    ${MUTED}# Run command${NC}"
echo -e ""
