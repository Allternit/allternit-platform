{
  "name": "allternit-gizzi-code",
  "displayName": "Gizzi Code",
  "description": "Run Gizzi Code with workspace and selection context inside VS Code.",
  "version": "1.2.10",
  "publisher": "allternit",
  "repository": {
    "type": "git",
    "url": "https://github.com/allternit/allternit"
  },
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:gizzi.openTerminal",
    "onCommand:gizzi.openNewTerminal",
    "onCommand:gizzi.addFilepathToTerminal",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gizzi.openTerminal",
        "title": "Gizzi Code: Open",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "gizzi.openNewTerminal",
        "title": "Gizzi Code: New Session",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "gizzi.addFilepathToTerminal",
        "title": "Gizzi Code: Add File or Selection"
      },
      {
        "command": "gizzi.reconnect",
        "title": "Gizzi Code: Reconnect"
      },
      {
        "command": "gizzi.showLogs",
        "title": "Gizzi Code: Show Logs"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gizzi.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "gizzi.openTerminal",
        "title": "Open Gizzi Code",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "gizzi.openNewTerminal",
        "title": "New Gizzi Code Session",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "gizzi.addFilepathToTerminal",
        "title": "Gizzi Code: Add File or Selection",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ],
    "configuration": {
      "title": "Gizzi Code",
      "properties": {
        "gizzi.cliPath": {
          "type": "string",
          "default": "gizzi",
          "description": "Path or command used to launch the Gizzi Code CLI."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile && bun run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node scripts/skip-vscode-test.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
