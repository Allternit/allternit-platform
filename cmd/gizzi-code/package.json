{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.1.9",
  "name": "@allternit/gizzi-code",
  "description": "AI-powered terminal interface for the Allternit ecosystem",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://docs.gizziio.com",
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "https://github.com/Allternit/allternit-platform.git",
    "directory": "cmd/gizzi-code"
  },
  "bugs": {
    "url": "https://github.com/Allternit/allternit-platform/issues"
  },
  "keywords": [
    "allternitchitect",
    "shell",
    "terminal",
    "tui",
    "cli",
    "gizzi-code"
  ],
  "scripts": {
    "typecheck": "bash script/ensure-sdk-dist.sh && NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "bash script/ci-smoke-test.sh",
    "test:full": "bun test --timeout 30000 --preload ./test/preload.ts test/",
    "build": "bun run script/build.ts",
    "dev": "bun script/dev.mjs",
    "start": "bun script/dev.mjs",
    "fix:hang": "bash script/fix-hang.sh",
    "e2e:clerk-login": "bun run script/terminal-clerk-e2e.ts",
    "clean": "echo 'Cleaning up...' && rm -rf node_modules dist",
    "lint": "bash script/ensure-sdk-dist.sh && NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "db": "bun drizzle-kit",
    "vm:download": "bun run src/runtime/vm/vm-image-download.ts",
    "release": "bash script/clean-bak.sh && bun run build --all",
    "clean:bak": "bash script/clean-bak.sh",
    "prepublishOnly": "node script/check-publish.js",
    "prepack": "node script/check-publish.js"
  },
  "bin": {
    "gizzi": "./bin/gizzi.js",
    "gizzi-code": "./bin/gizzi.js"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "docs/",
    "assets/",
