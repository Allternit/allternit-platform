# Allternit Cloud API — environment template.
# Copy to .env (chmod 600) next to the production binary
# (/opt/allternit-cloud-api/.env on the `mail` VPS — see
# docs/Operations/CLOUD_API_VPS_DEPLOY.md). All vars are optional unless noted.

# --- Required in production (the service exits at startup without it) ---
DATABASE_URL=postgres://allternit:CHANGE_ME@localhost:5432/allternit

# Bind address (default 0.0.0.0:3001; production nginx fronts 443 -> 8082).
BIND_ADDR=0.0.0.0:8082

# Development mode: disables auth entirely and makes CORS permissive.
# NEVER set in production. See also ALLTERNIT_ALLOW_DEV_TOKEN below.
Allternit_API_DEVELOPMENT_MODE=false

# --- Dev-token backdoor gate (audit finding B1) ---
# The hardcoded `dev-api-token` bearer is honored ONLY when this is exactly
# `true` (or `1`). Default OFF: production rejects the token. A warn-level
# startup log line fires whenever this is enabled so it can never be on
# silently. Leave unset/false in every deployed environment.
ALLTERNIT_ALLOW_DEV_TOKEN=false

# Comma-separated CORS origins (production mode only).
CORS_ALLOWED_ORIGINS=https://platform.allternit.com,https://ai.allternit.com,https://m.allternit.com

# Max request body size in bytes (default 10MB).
MAX_BODY_SIZE_BYTES=10485760

# --- Optional provider integrations ---
HETZNER_API_TOKEN=
OPENROUTER_API_KEY=

# --- Pool tuning ---
DB_MAX_CONNECTIONS=
DB_ACQUIRE_TIMEOUT_SECS=
