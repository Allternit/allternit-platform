# Allternit Cloud API — environment template.
# Copy to .env (chmod 600) next to the production binary
# (/opt/allternit-cloud-api/.env on the `mail` VPS — see
# docs/Operations/CLOUD_API_VPS_DEPLOY.md). All vars are optional unless noted.

# --- Required in production (the service exits at startup without it) ---
DATABASE_URL=postgres://allternit:CHANGE_ME@localhost:5432/allternit

# Bind address (default 0.0.0.0:3001; production nginx fronts 443 -> 8082).
BIND_ADDR=0.0.0.0:8082

# Development mode: disables auth entirely and makes CORS permissive.
# NEVER set in production. See also ALLTERNIT_ALLOW_DEV_TOKEN below.
Allternit_API_DEVELOPMENT_MODE=false

# --- Dev-token backdoor gate (audit finding B1) ---
# The hardcoded `dev-api-token` bearer is honored ONLY when this is exactly
# `true` (or `1`). Default OFF: production rejects the token. A warn-level
# startup log line fires whenever this is enabled so it can never be on
# silently. Leave unset/false in every deployed environment.
ALLTERNIT_ALLOW_DEV_TOKEN=false

# Comma-separated CORS origins (production mode only).
CORS_ALLOWED_ORIGINS=https://platform.allternit.com,https://ai.allternit.com,https://m.allternit.com

# Max request body size in bytes (default 10MB).
MAX_BODY_SIZE_BYTES=10485760

# --- Optional provider integrations ---
HETZNER_API_TOKEN=
OPENROUTER_API_KEY=

# --- Pool tuning ---
DB_MAX_CONNECTIONS=
DB_ACQUIRE_TIMEOUT_SECS=

# --- Agency API forward (WP11) ---
# api.allternit.com forwards /v1/agency, /v1/runs*, /v1/attention*,
# /v1/campaigns*, /v1/replays*, /v1/receipts/:id, the catalog routes and the
# public /.well-known/jwks.json to the allternit-api node on this host.
ALLTERNIT_AGENCY_NODE_URL=http://127.0.0.1:8013
# Trusted-peer secret; must equal the node's ALLTERNIT_DESKTOP_ACCESS_TOKEN.
# Keep the real value in the host .env only. Unset = Agency routes answer 503
# (fail closed); the JWKS is still served.
ALLTERNIT_AGENCY_NODE_ACCESS_TOKEN=

# --- Cloud Voice tickets + minutes metering ---
# HMAC secret (>= 32 chars) shared with the voice service; signs 60 s voice tickets.
# Unset or short = POST /api/v1/voice/tickets answers 503 cloud-unavailable.
ALLTERNIT_VOICE_TICKET_SECRET=
# Where the app connects with a ticket, e.g. wss://voice.allternit.com/v1/voice/session
ALLTERNIT_VOICE_CLOUD_WS_URL=
# Bearer token (>= 32 chars) the voice service sends to /api/v1/voice/tickets/redeem
# and /api/v1/voice/usage. Unset or short = those routes answer 503.
ALLTERNIT_VOICE_WORKER_TOKEN=

# --- Photo avatars included with a plan (routes::photo_avatars) ---
# Uses OPENAI_API_KEY (Allternit's account). Set this only to use a different key
# for avatars. Neither set = the lane reports not_configured and the app hides it.
ALLTERNIT_AVATAR_OPENAI_API_KEY=
# Global spend cap for the lane per UTC month, all users ($0.042 per image).
# At the cap the lane reports "paused" instead of making a paid call. Default 4.00.
ALLTERNIT_AVATAR_MONTHLY_BUDGET_USD=4.00
