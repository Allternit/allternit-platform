# Build-context exclusions specific to the hosted runtime image. This file
# takes precedence over the repository-level .dockerignore for this Dockerfile.
.git
.gitignore
.github/

node_modules
**/node_modules/
.pnpm-store
**/.pnpm-store/
.cache
**/.cache/
.cargo
.npm
.bun

target
**/target/
dist
**/dist/
build
**/build/
**/.build/
.next
**/out/

.data
data/
**/*.db
**/*.db-journal
**/*.log

surfaces/
resources/
tools/
docs/
archive/
.references/

services/open-notebook/
services/open-connector/
services/computer-use-operator/
services/gateway/
# ...except the two Rust workspace members under it: cargo loads every member's
# manifest, so excluding them fails `cargo build -p allternit-mux` (red since 2026-09-26).
!services/gateway/routing/
!services/gateway/routing/**
!services/gateway/stdio/
!services/gateway/stdio/**

**/models/
**/weights/
**/checkpoints/
**/checkpoints-*/
**/*.bin
**/*.safetensors
**/*.pt
**/*.pth
**/*.onnx
**/*.gguf
**/*.wav
**/*.mp3
**/*.ogg
**/*.mp4
**/*.mov
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.webp
**/*.pdf
**/*.ttf
**/*.woff
**/*.woff2
**/*.zip
**/*.tar.gz

# The Gizzi compiler consumes these checked-in package artifacts. The
# gizzi-util dist directory is generated from tracked source during the build.
!cmd/gizzi-code/packages/plugin/dist/
!cmd/gizzi-code/packages/plugin/dist/**
!cmd/gizzi-code/packages/script/dist/
!cmd/gizzi-code/packages/script/dist/**
!cmd/gizzi-code/packages/sdk/dist/
!cmd/gizzi-code/packages/sdk/dist/**
