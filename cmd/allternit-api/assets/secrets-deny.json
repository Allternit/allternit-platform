{
  "_comment": "One secrets deny-list for the runtime and Gizzi. allternit-api files_scope.rs refuses home_paths (home-relative, matched case-insensitively component by component) on every Files path. Gizzi's portable workspace bundle (cmd/gizzi-code/src/runtime/teleport/bundle.ts) leaves out any path that contains one of home_paths, or whose file name matches file_patterns. Edit this file, not a copy.",
  "home_paths": [
    [".ssh"],
    [".gnupg"],
    [".aws"],
    [".azure"],
    [".kube"],
    [".netrc"],
    [".password-store"],
    [".npmrc"],
    [".pypirc"],
    [".git-credentials"],
    [".docker", "config.json"],
    [".config", "gcloud"],
    [".config", "gh"],
    [".config", "stripe"],
    ["Library", "Keychains"],
    [".claude", ".credentials.json"],
    [".codex", "auth.json"],
    [".gizzi", "credentials.json"],
    [".local", "share", "gizzi-code", "auth.json"],
    [".local", "share", "gizzi-code", "fabric-lease.key"],
    [".local", "share", "tailscale"],
    [".allternit", "phone-gateway.json"],
    [".allternit", "subscriptions"],
    [".allternit", "incus-client"],
    [".allternit", "factory", "fabric"],
    [".allternit", "factory", "registry.json"],
    [".allternit", "session-caretaker"],
    [".allternit", "system-one"]
  ],
  "file_patterns": [
    ".env",
    ".env.*",
    "*.env",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.keystore",
    "*.kdbx",
    "*.keychain",
    "*.keychain-db",
    "*.token",
    "id_rsa*",
    "id_dsa*",
    "id_ecdsa*",
    "id_ed25519*",
    "credentials",
    "credentials.json",
    "token.json",
    "tokens.json",
    "auth.json",
    ".htpasswd",
    "service-account*.json"
  ]
}
