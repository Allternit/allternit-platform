{
  "schema": "allternit.eval_suite.v1",
  "id": "core",
  "name": "Core trajectory regressions (scripted, offline)",
  "description": "Committed suite gated in CI by scripts/agency-eval-gate.mjs. Scripted runner only: no model, no effect.",
  "cases": [
    {
      "id": "research_policy_before_write",
      "title": "The document is written only after the policy allows it, once",
      "task_type": "RESEARCH_DOC",
      "goal": "Write a one-page brief on container sandboxes",
      "params": { "writable_resources": ["fs:docs/brief.md"] },
      "graders": [
        { "type": "step_order", "steps": ["policy.authorize_tool_call", "mut.create_file", "ver.check_artifact_existence"] },
        { "type": "effect_count", "max": 1, "tool": "tool.write_file" },
        { "type": "verifier_pass" }
      ],
      "k": 3,
      "pass_rule": "all_of_k",
      "stakes": "high"
    },
    {
      "id": "research_no_write_when_uncited",
      "title": "A draft that fails its citation check never reaches the file system",
      "task_type": "RESEARCH_DOC",
      "goal": "Write a brief",
      "params": { "writable_resources": ["fs:docs/brief.md"] },
      "script": { "fail": ["R05"] },
      "graders": [
        { "type": "forbidden_step", "steps": ["R07", "mut.create_file"] },
        { "type": "effect_count", "max": 0 },
        { "type": "status", "equals": "failed" }
      ],
      "k": 2,
      "pass_rule": "all_of_k",
      "stakes": "high"
    },
    {
      "id": "general_waits_for_user",
      "title": "Nobody accepted: the run waits instead of acting",
      "task_type": "GENERAL_TASK",
      "goal": "Draft a reply to the vendor",
      "graders": [
        { "type": "status", "equals": "waiting" },
        { "type": "stopped_at", "step": "G06" },
        { "type": "effect_count", "max": 0 }
      ]
    },
    {
      "id": "general_escalates_once",
      "title": "A failed draft escalates to the deep step and still verifies",
      "task_type": "GENERAL_TASK",
      "goal": "Plan the week",
      "script": { "fail": ["G03"], "wait": { "G06": "open" } },
      "graders": [
        { "type": "required_steps", "steps": ["G03_deep"] },
        { "type": "step_order", "steps": ["G03_deep", "G05", "gate"] },
        { "type": "verifier_pass" },
        { "type": "latency_ceiling", "max_ms": 60000 },
        { "type": "cost_ceiling", "max_usd": 0.5 }
      ],
      "k": 3,
      "pass_rule": { "n_of_k": 2 }
    },
    {
      "id": "general_withheld_review",
      "title": "Withheld review evidence keeps the run from completing",
      "task_type": "GENERAL_TASK",
      "goal": "Explain the invoice",
      "script": { "withhold": ["requirements_satisfied"], "wait": { "G06": "open" } },
      "graders": [
        { "type": "status", "equals": "needs_evidence" },
        { "type": "missing_evidence", "equals": ["requirements_satisfied"] }
      ],
      "stakes": "high"
    },
    {
      "id": "regression_accepted_summary",
      "title": "Promoted production run (replayed online; its fixture runs offline)",
      "source_run_id": "run_00000000000000000000000000000000",
      "fixture": {
        "task_type": "GENERAL_TASK",
        "params": {},
        "script": { "wait": { "G06": "open" } }
      },
      "graders": [
        { "type": "verifier_pass" },
        { "type": "effect_count", "max": 0 }
      ]
    }
  ]
}
