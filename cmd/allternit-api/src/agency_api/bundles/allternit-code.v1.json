{
  "schema_id": "allternit.agency.AgentBundleManifestV1",
  "schema_version": "1.0.0",
  "agent_id": "allternit-code",
  "version": "v1",
  "description": "Code agent: fixes defects and verifies the repair with receipt-backed evidence.",
  "templates": ["BUG_FIX"],
  "default_template": "BUG_FIX",
  "capabilities": ["fs.read", "fs.write", "shell.exec", "vcs.commit", "tests.run"],
  "defaults": {
    "workspace": { "ref": "sandbox://per-run-scratch" },
    "authority_profile": { "id": "code-safe", "version": 1 },
    "budget": { "max_seconds": 900, "max_cost_usd": 2.0, "max_steps": 50, "max_attention_requests": 3, "on_exhaustion": "request_attention" },
    "completion_contract": { "id": "completion.bug_fix", "version": 1 }
  },
  "hard_limits": { "max_seconds": 3600, "max_cost_usd": 25.0, "max_steps": 500 },
  "authority_profiles": ["code-safe", "read-only"],
  "enforcement": { "judge_fail_closed": true, "verifier_owned_completion": true, "origin": "agency", "requires_lease_for_write": true }
}
