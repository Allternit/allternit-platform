# The same GUI sandbox as Dockerfile, with the Allternit Driver baked in.
# Build from the domains/computer-use directory so the driver package is in
# the context:
#
#   docker build -f core/sandbox/container/Dockerfile.driver \
#     -t allternit-computer-sandbox:driver domains/computer-use
#
# The driver then serves read_ui/act/run_batch/verify on
# /run/allternit/driver.sock inside the container; allternit-api reaches it
# through the exec channel (docker exec sh -c
# 'printf %s <b64> | /usr/local/bin/allternit-driver-rpc').
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY_NUM=1
ENV DISPLAY=:1
ENV WIDTH=1280
ENV HEIGHT=800

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    xdotool \
    scrot \
    imagemagick \
    x11vnc \
    mutter \
    python3 \
    python3-websockify \
    git \
    ca-certificates \
    python3-pyatspi \
    at-spi2-core \
    libatk-adaptor \
    libatk-bridge2.0-0 \
    python3-pil \
    dbus-x11 \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v1.5.0 https://github.com/novnc/noVNC.git /opt/noVNC \
    && ln -s /opt/noVNC/vnc.html /opt/noVNC/index.html

# The driver package + exec-channel forwarder (context: domains/computer-use).
COPY driver/allternit_driver /opt/allternit-driver/allternit_driver
RUN cp /opt/allternit-driver/allternit_driver/guest_rpc.py /opt/allternit-driver/guest-rpc.py \
    && chmod 0755 /opt/allternit-driver/guest-rpc.py \
    && printf '#!/bin/sh\nexec /usr/bin/python3 /opt/allternit-driver/guest-rpc.py "$@"\n' \
       > /usr/local/bin/allternit-driver-rpc \
    && chmod 0755 /usr/local/bin/allternit-driver-rpc \
    && mkdir -p /run/allternit

COPY core/sandbox/container/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5900 6080

ENTRYPOINT ["/entrypoint.sh"]
