{
  "id": "windows-browser-shipping-form",
  "os": "windows",
  "status": "needs_test_machine",
  "apps": [
    "Microsoft Edge"
  ],
  "setup": [
    {
      "do": "open",
      "app": "Microsoft Edge",
      "url": "{base_url}/shipping.html"
    }
  ],
  "goal": "In Microsoft Edge, fill in the shipping form with the values below, tick Express delivery and click Place order.",
  "inputs": {
    "full_name": "Dana Reyes",
    "street": "18 Elm Street",
    "city": "Saint Paul",
    "zip": "55102",
    "country": "United States"
  },
  "checker": [
    {
      "kind": "form_log",
      "route": "shipping",
      "count": 1,
      "fields": {
        "full_name": "Dana Reyes",
        "zip": "55102",
        "country": "United States",
        "express": "yes"
      }
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "browser",
    "form"
  ]
}
