{
  "id": "linux-browser-login-credential",
  "os": "linux",
  "status": "needs_test_machine",
  "apps": [
    "Firefox"
  ],
  "setup": [
    {
      "do": "keychain_secret",
      "name": "suite-portal-login",
      "as": "login"
    },
    {
      "do": "open",
      "app": "Firefox",
      "url": "{base_url}/login.html"
    }
  ],
  "goal": "In Firefox, type the username below and put the stored credential suite-portal-login into Password with computer_v2 use_credential, then click Sign in.",
  "inputs": {
    "username": "suite-user",
    "credential": "suite-portal-login"
  },
  "checker": [
    {
      "kind": "form_log",
      "route": "login",
      "count": 1,
      "fields": {
        "username": "suite-user",
        "password_ok": true
      }
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "browser",
    "credential"
  ]
}
