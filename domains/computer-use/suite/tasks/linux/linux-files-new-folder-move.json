{
  "id": "linux-files-new-folder-move",
  "os": "linux",
  "status": "needs_test_machine",
  "apps": [
    "Files"
  ],
  "setup": [
    {
      "do": "write_file",
      "path": "old.txt",
      "text": "old\n"
    },
    {
      "do": "open",
      "app": "Files",
      "path": "."
    }
  ],
  "goal": "In Files, create a folder named as below and move old.txt into it.",
  "inputs": {
    "folder": "Archive"
  },
  "checker": [
    {
      "kind": "file_exists",
      "path": "Archive/old.txt"
    },
    {
      "kind": "file_absent",
      "path": "old.txt"
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "files"
  ]
}
