{
  "id": "linux-files-rename",
  "os": "linux",
  "status": "needs_test_machine",
  "apps": [
    "Files"
  ],
  "setup": [
    {
      "do": "write_file",
      "path": "report-draft.txt",
      "text": "q3 report\n"
    },
    {
      "do": "open",
      "app": "Files",
      "path": "."
    }
  ],
  "goal": "In Files, rename report-draft.txt to the name below.",
  "inputs": {
    "new_name": "report-final.txt"
  },
  "checker": [
    {
      "kind": "dir_names",
      "path": ".",
      "names": [
        "report-final.txt"
      ]
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "files"
  ]
}
