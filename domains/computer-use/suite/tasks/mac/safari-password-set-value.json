{
  "id": "safari-password-set-value",
  "os": "mac",
  "status": "ready",
  "apps": [
    "Safari"
  ],
  "setup": [
    {
      "do": "keychain_secret",
      "name": "suite-portal-login",
      "as": "login"
    },
    {
      "do": "safari_window",
      "name": "A",
      "url": "{base_url}/isolation.html?w=A&pw=1"
    },
    {
      "do": "safari_window",
      "name": "B",
      "url": "{base_url}/isolation.html?w=B&focus=1",
      "key": true
    },
    {
      "do": "user_typing",
      "window": "B",
      "text": "user-bravo-abcdefghij",
      "delay_ms": 1500,
      "interval_ms": 250
    }
  ],
  "goal": "In Safari, the window titled \"Suite A\" is yours. Put the stored credential named suite-portal-login into its \"A field\" (a password field) with computer_v2 use_credential (domain 127.0.0.1), targeting that window by its window_id. The person is typing in the window \"Suite B\" right now: do not touch it.",
  "inputs": {
    "window": "Suite A",
    "credential": "suite-portal-login",
    "window_id": "{A_window_id}"
  },
  "checker": [
    {
      "kind": "background_done",
      "timeout_ms": 30000
    },
    {
      "kind": "form_log",
      "route": "login",
      "fields": {
        "window": "A",
        "password_ok": true
      }
    },
    {
      "kind": "form_log",
      "route": "iso-B",
      "fields": {
        "value": "user-bravo-abcdefghij"
      }
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "safari",
    "browser",
    "isolation",
    "credential",
    "agent-browser"
  ],
  "requires": [
    "read_ui",
    "use_credential"
  ]
}
