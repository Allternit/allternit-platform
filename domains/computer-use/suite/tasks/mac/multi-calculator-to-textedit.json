{
  "id": "multi-calculator-to-textedit",
  "os": "mac",
  "status": "ready",
  "apps": [
    "Calculator",
    "TextEdit"
  ],
  "setup": [
    {
      "do": "write_file",
      "path": "answer.txt",
      "text": ""
    },
    {
      "do": "open",
      "app": "TextEdit",
      "path": "answer.txt"
    },
    {
      "do": "open",
      "app": "Calculator"
    },
    {
      "do": "toolset",
      "member": "key",
      "input": {
        "text": "Escape"
      }
    },
    {
      "do": "toolset",
      "member": "key",
      "input": {
        "text": "Escape"
      }
    }
  ],
  "goal": "Use Calculator to compute the product below, then type just the result into the TextEdit window showing answer.txt and save it.",
  "inputs": {
    "expression": "1234 x 5"
  },
  "checker": [
    {
      "kind": "file_equals",
      "path": "answer.txt",
      "text": "6170"
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "calculator",
    "textedit",
    "multi-app"
  ]
}
