{
  "id": "safari-login-credential",
  "os": "mac",
  "status": "ready",
  "apps": [
    "Safari"
  ],
  "setup": [
    {
      "do": "keychain_secret",
      "name": "suite-portal-login",
      "as": "login"
    },
    {
      "do": "open",
      "app": "Safari",
      "url": "{base_url}/login.html",
      "settle_ms": 800
    }
  ],
  "goal": "In Safari, sign in to Suite Portal: type the username below, then put the stored credential named suite-portal-login into the Password field with computer_v2 use_credential (domain 127.0.0.1), then click Sign in.",
  "inputs": {
    "username": "suite-user",
    "credential": "suite-portal-login"
  },
  "checker": [
    {
      "kind": "form_log",
      "route": "login",
      "count": 1,
      "fields": {
        "username": "suite-user",
        "password_ok": true
      }
    }
  ],
  "teardown": [],
  "max_minutes": 3,
  "tags": [
    "safari",
    "browser",
    "credential",
    "core"
  ],
  "requires": [
    "use_credential"
  ]
}
