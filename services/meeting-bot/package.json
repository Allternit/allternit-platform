{
  "name": "@allternit/meeting-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Allternit Meetings pod: one Chrome per meeting session joins Meet/Teams (Zoom via its SDK adapter), shows the Gizzi tile, publishes call audio to LiveKit and reports to cloud-api with the pod token.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/runner.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/runner.js",
    "test": "tsc -p test/zoom/tsconfig.json && node --test dist/test/test/zoom/zoom.test.js dist/test/test/zoom/media.test.js"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.2.1",
    "livekit-client": "2.22.3",
    "playwright-core": "1.56.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "linkedom": "0.18.12",
    "typescript": "^6.0.3"
  }
}
