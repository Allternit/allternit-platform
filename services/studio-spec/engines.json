[
  {
    "id": "allternit-tune",
    "name": "Allternit Tune",
    "license": "Apache-2.0",
    "version": "0.1.0",
    "methods": [
      "lora",
      "qlora",
      "full",
      "dpo"
    ],
    "hardware": [
      "apple-silicon",
      "cuda-linux",
      "cuda-windows",
      "rocm-linux",
      "xpu-linux",
      "xpu-windows",
      "cpu"
    ],
    "install_state": "not_installed",
    "limits": {
      "max_seq_len": 8192,
      "mlx_unsupported_methods": [
        "dpo",
        "full"
      ]
    },
    "published": true,
    "process": "embedded",
    "default": true,
    "backends": [
      {
        "id": "torch",
        "status": "available"
      },
      {
        "id": "mlx",
        "status": "available"
      }
    ],
    "notes": "PyTorch on every computer; MLX on a Mac for LoRA and QLoRA. QLoRA uses bitsandbytes 4-bit off the Mac. On the CPU only LoRA runs, and slowly."
  },
