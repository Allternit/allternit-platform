    "linkedom": "0.18.12",
    "turndown": "7.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "5.0.5",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.1"
