{
  "name": "@allternit/office-engine-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototype office-engine service for GenOffice Phase 0 proof",
  "license": "MIT",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
