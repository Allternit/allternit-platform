{
  "version": 1,
  "classes": {
    "safe": "The runtime applies the change. The card offers Undo.",
    "confirm": "Security, privacy or instructions. Applied only by the user's own tap, under their sign-in. Refused for runs an automation started.",
    "locked": "Money or account. Never changed from a chat; the card links to Settings."
  },
  "settings": [
    { "key": "appearance.theme", "class": "safe", "scope": "device", "type": "enum", "values": ["system", "light", "dark"], "label": "Theme", "store": { "ai": "localStorage allternit-theme-storage-v2", "ios": "UserDefaults allternit-appearance-theme" } },
    { "key": "appearance.chat_font", "class": "safe", "scope": "device", "type": "string", "label": "Chat font", "store": { "ios": "UserDefaults allternit-appearance-chat-font" } },
    { "key": "chat.answer_style", "class": "safe", "scope": "account", "type": "enum", "values": ["concise", "balanced", "detailed", "custom"], "label": "Answer style", "store": { "api": "/agent-preferences response_style" } },
    { "key": "browser.preferred", "class": "safe", "scope": "account", "type": "string", "label": "Browser for links", "store": { "api": "/cowork-preferences preferred_browser" } },
    { "key": "browser.open_links_in_app", "class": "safe", "scope": "account", "type": "boolean", "label": "Open links in the app", "store": { "api": "/cowork-preferences open_links_in_app" } },
    { "key": "notifications.*", "class": "safe", "scope": "device", "type": "boolean", "label": "Notification toggles", "store": { "ios": "UserDefaults notifications.*" } },
    { "key": "gizzi.tui_theme", "class": "safe", "scope": "runtime", "type": "string", "label": "Terminal theme", "store": { "gizzi": "config" } },
    { "key": "gizzi.model", "class": "safe", "scope": "runtime", "type": "string", "label": "Model", "store": { "gizzi": "config" } },
    { "key": "gizzi.verbose", "class": "safe", "scope": "runtime", "type": "boolean", "label": "Verbose output", "store": { "gizzi": "config" } },

    { "key": "instructions.global", "class": "confirm", "scope": "account", "type": "string", "label": "Global instructions", "settings_path": "settings/instructions", "store": { "api": "/cowork-preferences global_instructions" } },
    { "key": "instructions.custom", "class": "confirm", "scope": "account", "type": "string", "label": "Custom instructions", "settings_path": "settings/instructions", "store": { "api": "/agent-preferences custom_instructions" } },
    { "key": "memory.capture", "class": "confirm", "scope": "account", "type": "boolean", "label": "Memory capture", "settings_path": "settings/memory" },
    { "key": "memory.dreaming", "class": "confirm", "scope": "account", "type": "boolean", "label": "Memory dreaming", "settings_path": "settings/memory" },
    { "key": "security.require_trusted_devices", "class": "confirm", "scope": "account", "type": "boolean", "label": "Require trusted devices", "settings_path": "settings/security", "store": { "api": "/cowork-preferences require_trusted_devices" } },
    { "key": "files.trusted_folders", "class": "confirm", "scope": "account", "type": "list", "label": "Trusted folders", "settings_path": "settings/files", "store": { "api": "/cowork-preferences trusted_folders" } },
    { "key": "browser.allowed_sites", "class": "confirm", "scope": "account", "type": "list", "label": "Allowed sites", "settings_path": "settings/browser", "store": { "api": "/cowork-preferences allowed_sites" } },
    { "key": "gizzi.permission_mode", "class": "confirm", "scope": "runtime", "type": "enum", "values": ["default", "acceptEdits", "plan", "auto", "dontAsk"], "label": "Permission mode", "settings_path": "settings/permissions", "store": { "gizzi": "config" } },

    { "key": "account.plan", "class": "locked", "scope": "account", "type": "string", "label": "Plan", "settings_path": "settings/billing" },
    { "key": "account.billing", "class": "locked", "scope": "account", "type": "string", "label": "Billing", "settings_path": "settings/billing" },
    { "key": "account.email", "class": "locked", "scope": "account", "type": "string", "label": "Email", "settings_path": "settings/account" },
    { "key": "account.password", "class": "locked", "scope": "account", "type": "string", "label": "Password", "settings_path": "settings/account" },
    { "key": "account.keys", "class": "locked", "scope": "account", "type": "list", "label": "API keys", "settings_path": "settings/keys" }
  ]
}
