      "line": "The deploy failed on step 3."
    }
  },
  {
    "note": "plain DONT_NOTIFY",
    "input": "All green, same as last time.\nDONT_NOTIFY",
    "expected": {
      "kind": "dont_notify"
    }
  },
  {
    "note": "plain DONE",
