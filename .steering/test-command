#!/usr/bin/env bash
set -euo pipefail
# Read only the completed WP13 targeted-test evidence; never launch unrelated builds.
if [[ -f .tmp-wp13/validation.log ]]; then
  tail -n 24 .tmp-wp13/validation.log
else
  echo 'WP13 validation evidence pending'
fi
if [[ -f .tmp-wp13/steering-validation.log ]]; then
  cat .tmp-wp13/steering-validation.log
fi
