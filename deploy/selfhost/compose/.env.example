# Allternit Self-Hosted Agents: Docker Compose environment.
# Copy to .env (mode 0600) and fill in. Never commit .env.

# ── Images ───────────────────────────────────────────────────────────────────
# Leave as is to use the published images, or point at your own registry.
ALLTERNIT_VERSION=latest
#ALLTERNIT_SERVER_IMAGE=ghcr.io/allternit/allternit-agents-server
#ALLTERNIT_WORKER_IMAGE=ghcr.io/allternit/allternit-selfhost-worker

# ── Settings file ────────────────────────────────────────────────────────────
# Path to your settings, relative to this folder. Default: ../settings.example.yaml
#ALLTERNIT_SETTINGS_FILE=../settings.yaml

# ── Database ─────────────────────────────────────────────────────────────────
# Password for the bundled PostgreSQL 16. Generate: openssl rand -base64 24
ALLTERNIT_PG_PASSWORD=

# ── Model provider ───────────────────────────────────────────────────────────
# Used by settings: inference.credentials.api_key: env:ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# ── Server secrets ───────────────────────────────────────────────────────────
# One-time token for `admin setup`, which mints the first admin API key.
# Generate: openssl rand -hex 32. Clear it after setup.
ALLTERNIT_SELF_HOSTED_SETUP_TOKEN=
# Encrypts stored credentials. 32 random bytes, base64: openssl rand -base64 32
# Back it up. Without it, stored credentials cannot be read.
ALLTERNIT_ENCRYPTION_KEY=

# ── Workers ──────────────────────────────────────────────────────────────────
# Fill in after first setup (OPERATOR-GUIDE.md, "First run"), then turn on the
# workers profile.
ALLTERNIT_ENVIRONMENT_ID=
ALLTERNIT_ENVIRONMENT_KEY=
ALLTERNIT_WORKER_REPLICAS=10
# Ubuntu 24.04+ hosts (kernel.apparmor_restrict_unprivileged_userns=1): load
# ../apparmor/allternit-selfhost-worker and uncomment this, or bash fails in every worker.
#ALLTERNIT_WORKER_APPARMOR=allternit-selfhost-worker
#COMPOSE_PROFILES=workers

# ── OpenTelemetry (optional) ─────────────────────────────────────────────────
# Local check: COMPOSE_PROFILES=workers,otel and
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
#OTEL_SERVICE_NAME=allternit-agents-server
