# syntax=docker/dockerfile:1.7
#
# Allternit Self-Hosted Agents: the sandbox worker image (`gizzi worker`).
#
# The worker polls the Agents Server over outbound HTTP(S), claims work for one
# environment, and runs sandbox tools (bash, file edits, search) in /workspace.
# It never accepts inbound connections.
#
# Build context: repository root.
#   docker build -f deploy/selfhost/Dockerfile.worker -t allternit-selfhost-worker .
#
# Run:
#   ALLTERNIT_SERVER_URL       http(s)://<server>:8400
#   ALLTERNIT_ENVIRONMENT_ID   env_...
#   ALLTERNIT_ENVIRONMENT_KEY  aek_...  (from: allternit-agents-server admin env-keys create <env id>)
#
# ── Container privileges bubblewrap needs ────────────────────────────────────
# Every bash call runs inside bubblewrap (bwrap) with the environment's network
# policy (none / limited / full). `gizzi worker` turns the sandbox on for every
# claimed session itself, so GIZZI_SANDBOX_DISABLE does not turn it off, and
# there is no --no-sandbox flag: without a working bwrap the bash tool fails
# closed with an error. bwrap runs unprivileged here (no setuid, no added
# capabilities) and needs the runtime to allow:
#   1. Unprivileged user namespaces. The default Docker seccomp profile blocks
#      unshare(CLONE_NEWUSER), and the default AppArmor profile blocks mounts.
#      Docker: --security-opt seccomp=unconfined --security-opt apparmor=unconfined
#      (or a custom seccomp profile that allows unshare/clone with namespace flags).
#      Kubernetes: seccompProfile Unconfined, appArmorProfile Unconfined.
#   2. Mounting a fresh /proc. Docker masks parts of /proc, and the kernel then
#      refuses a new procfs mount inside the sandbox.
#      Docker: --security-opt systempaths=unconfined
#      Kubernetes: securityContext.procMount: Unmasked (needs hostUsers: false,
#      the UserNamespacesSupport and ProcMountType feature gates on older clusters).
#   3. The host kernel must allow unprivileged user namespaces
#      (kernel.unprivileged_userns_clone=1 on Debian kernels; on Ubuntu 24.04+
#      load deploy/selfhost/apparmor/allternit-selfhost-worker and run the
#      container with --security-opt apparmor=allternit-selfhost-worker).
# Do not use --privileged. Nothing here needs CAP_SYS_ADMIN in the init namespace.
# The compose file and the sandboxes Helm chart already set these options.
# Quick check from inside a running worker:
#   bwrap --unshare-all --die-with-parent --ro-bind / / --proc /proc --dev /dev true && echo ok

ARG BUN_VERSION=1.3.14
ARG DEBIAN_RELEASE=bookworm

# ─────────────────────────────────────────────────────────────────────────────
# Stage 1: the gizzi CLI (same stage as Dockerfile.server; keep them in step).
FROM oven/bun:${BUN_VERSION}-debian AS gizzi-build

ARG TARGETARCH
ARG GIT_SHA=unknown
ENV GITHUB_SHA=${GIT_SHA} \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    CI=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git nodejs npm python3 make g++ \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g pnpm@10.28.0

WORKDIR /src
COPY . .

RUN --mount=type=cache,target=/root/.local/share/pnpm/store,sharing=locked \
    pnpm install --frozen-lockfile \
    && pnpm --filter "@allternit/gizzi-code^..." run build \
    && pnpm --filter "@allternit/gizzi-sdk" run build

RUN case "${TARGETARCH:-amd64}" in \
      amd64) GZ=linux-x64 ;; \
      arm64) GZ=linux-arm64 ;; \
      *) echo "unsupported TARGETARCH ${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && cd cmd/gizzi-code \
    && bun run build --target="${GZ}" \
    && mkdir -p /out/gizzi \
    && cp "dist/gizzi-code-${GZ}" /out/gizzi/gizzi-code \
    && if [ -d dist/native-assets ]; then cp -r dist/native-assets /out/gizzi/; fi \
    && chmod 0755 /out/gizzi/gizzi-code

# ─────────────────────────────────────────────────────────────────────────────
# Stage 2: runtime.
FROM debian:${DEBIAN_RELEASE}-slim AS runtime

# bubblewrap: the bash sandbox. socat: the CONNECT proxy bridge for
# network: limited. git: clone/push under the environment's git policy.
# ripgrep: the grep tool. tini: PID 1 that forwards SIGTERM (the worker then
# releases its item) and reaps sandbox children.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates libstdc++6 bubblewrap socat git ripgrep tini \
       bash coreutils findutils procps \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system --gid 10002 gizzi-worker \
    && useradd --system --uid 10002 --gid gizzi-worker --home-dir /var/lib/gizzi-worker \
       --shell /usr/sbin/nologin gizzi-worker \
    && install -d -o gizzi-worker -g gizzi-worker -m 0750 /var/lib/gizzi-worker \
    && install -d -o gizzi-worker -g gizzi-worker -m 0750 /workspace

COPY --from=gizzi-build /out/gizzi /opt/gizzi
RUN ln -s /opt/gizzi/gizzi-code /usr/local/bin/gizzi-code \
    && ln -s /opt/gizzi/gizzi-code /usr/local/bin/gizzi \
    && gizzi --version

ENV ALLTERNIT_SELF_HOSTED=1 \
    ALLTERNIT_WORKDIR=/workspace \
    GIZZI_DISABLE_AUTOUPDATE=1 \
    ALLTERNIT_SIDECAR_DISABLED=1 \
    HOME=/var/lib/gizzi-worker \
    XDG_DATA_HOME=/var/lib/gizzi-worker/data \
    XDG_CONFIG_HOME=/var/lib/gizzi-worker/config \
    XDG_STATE_HOME=/var/lib/gizzi-worker/state \
    XDG_CACHE_HOME=/var/lib/gizzi-worker/cache

USER 10002:10002
WORKDIR /workspace
VOLUME ["/workspace"]

# The worker reads ALLTERNIT_SERVER_URL, ALLTERNIT_ENVIRONMENT_ID and
# ALLTERNIT_ENVIRONMENT_KEY from the environment. Extra flags (--drain,
# --block-ms, --reclaim-older-than-ms, --auto-stop, --on-work) go after the
# image name and are appended to this command.
ENTRYPOINT ["/usr/bin/tini", "--", "gizzi", "worker", "--workdir", "/workspace"]
