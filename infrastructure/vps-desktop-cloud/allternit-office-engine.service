[Unit]
Description=Allternit office engine (workbook sessions for people with no computer)
After=network.target

[Service]
Type=simple
# Files people upload are parsed here, so this service gets as little as it can:
# no account of its own, nothing writable but a private /tmp, no way out to any
# network, and a hard ceiling on memory. Sessions are in memory, so a restart
# drops them; the client reopens its file.
DynamicUser=yes
ExecStart=/usr/bin/node --max-old-space-size=2048 /opt/allternit-office-engine/current/engine/dist/index.js
WorkingDirectory=/opt/allternit-office-engine/current/engine
Environment=NODE_ENV=production
Environment=OFFICE_ENGINE_HOST=127.0.0.1
Environment=OFFICE_ENGINE_PORT=8099
Environment=OFFICE_ENGINE_SESSIONS_ONLY=1
Environment=ALLTERNIT_XLSX_SIDECAR_BINARY=/opt/allternit-office-engine/current/bin/allternit-xlsx-sidecar
Restart=always
RestartSec=3
MemoryMax=4G
MemoryHigh=3G
CPUQuota=300%
TasksMax=128
LimitNOFILE=4096
PrivateTmp=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Answers the gateways on this host and reaches nothing else.
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
AmbientCapabilities=
SyslogIdentifier=allternit-office-engine

[Install]
WantedBy=multi-user.target
