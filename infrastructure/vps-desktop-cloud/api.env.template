# Allternit API runtime configuration for VPS deployment.
# Copy this file to /etc/allternit-api/api.env and fill in secrets.

ALLTERNIT_API_PORT=8013
ALLTERNIT_SELF_HOSTED=true
# NEVER set this to true on a production host. It enables the local-dev
# security bypass: permissive CORS mirrors any request origin, and auth
# middleware accepts a default local user / predictable dev desktop secret.
# It exists only for local development and packaged-app smoke tests.
ALLTERNIT_LOCAL_DEV_BYPASS=false
ALLTERNIT_DATA_DIR=/var/lib/allternit-api

# Comma-separated browser origins allowed to call this API cross-origin
# (Access-Control-Allow-Origin allowlist; requests without an Origin header,
# e.g. CLI/desktop/git clients, are never CORS-gated). The platform and ai
# surfaces reach this instance through the nginx proxy with these origins.
# The office-addins origins are the hosted Microsoft Office add-in task panes
# (Word/Excel/PowerPoint) deployed to Cloudflare Pages.
# When unset, the API falls back to a built-in default that already includes
# platform.allternit.com and ai.allternit.com plus localhost dev origins.
# NOTE: deploy.sh preserves an existing /etc/allternit-api/api.env (merges
# missing keys only), so on a live host you must EDIT this line in place and
# restart allternit-api.service for new origins to take effect.
ALLTERNIT_CORS_ORIGINS=https://platform.allternit.com,https://ai.allternit.com,https://allternit-office-addins.pages.dev,https://office-addins.allternit.com,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8013,http://127.0.0.1:3456

# Optional: exact origins ADDED on top of the list above (or the built-in
# default). Comma-separated scheme://host[:port] only — wildcards, paths and
# queries are rejected and logged at startup; the effective allowlist is
# logged once at boot. The API's own http://{localhost,127.0.0.1}:<port>
# origins are always allowed so its /embed/computers/:id viewer works.
# ALLTERNIT_ALLOWED_ORIGINS=http://127.0.0.1:18014

# Set to json for structured logs in production; omit for human-readable dev logs.
ALLTERNIT_LOG_FORMAT=json

# 32-byte hex encryption key (generate: openssl rand -hex 32)
ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_HEX

# Internal service token (generate: openssl rand -hex 32)
ALLTERNIT_INTERNAL_SERVICE_TOKEN=REPLACE_WITH_32_BYTE_HEX

# Self-hosted onboarding setup token (generate: openssl rand -hex 32)
ALLTERNIT_SELF_HOSTED_SETUP_TOKEN=REPLACE_WITH_32_BYTE_HEX

# Incus connection (local to the VPS)
INCUS_URL=https://127.0.0.1:8443
INCUS_CA_CERT=/etc/allternit-api/incus/ca.crt
# Client certificate the API uses to authenticate to Incus hosts. For
# cloud-provisioned hosts this cert is forwarded to bootstrap-host.sh so the
# host can add it to its Incus trust store.
INCUS_CLIENT_CERT=/etc/allternit-api/incus/client.crt
INCUS_CLIENT_KEY=/etc/allternit-api/incus/client.key
# Only set to true during initial bring-up when no CA cert is available.
INCUS_INSECURE_SKIP_VERIFY=false
INCUS_VNC_HOST=mail.news.allternit.com

# Desktop Cloud defaults
BOT_DESKTOP_IMAGE=allternit-desktop

# Remote Tart (macOS) host over Tailscale.
# Generate the token on the Mac by running infrastructure/tart-host/deploy.sh.
TART_HOST_URLS=http://100.88.98.69:8020
TART_HOST_TOKEN=REPLACE_WITH_TOKEN_FROM_MAC_DEPLOY
# Optional: override the VNC host advertised to clients (defaults to the URL host).
# TART_VNC_HOST=100.88.98.69

# Stripe billing (optional). When both are set, deprovisioning a desktop emits a
# usage record for the session minutes against the configured subscription item.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_DESKTOP_USAGE_SUBSCRIPTION_ITEM=si_...

# -----------------------------------------------------------------------------
# Multi-tenant VPS Desktop Cloud host provisioning
# -----------------------------------------------------------------------------

# Public URL and token used by freshly-bootstrapped Incus hosts to register
# themselves with the API. Generate the token with: openssl rand -hex 32
DESKTOP_HOST_REGISTRATION_URL=https://vps.example.com/api/v1/desktop-hosts/register
DESKTOP_HOST_REGISTRATION_TOKEN=REPLACE_WITH_32_BYTE_HEX

# Cloud provider credentials. At least one provider must be configured for
# autoscaled / remote host provisioning. If neither is configured, the API falls
# back to the single local Incus instance defined by INCUS_URL above.

# Hetzner Cloud (https://console.hetzner.cloud/projects)
HETZNER_API_TOKEN=REPLACE_WITH_HETZNER_TOKEN
HETZNER_SSH_KEY_ID=REPLACE_WITH_HETZNER_SSH_KEY_ID
HETZNER_DEFAULT_REGION=nbg1
HETZNER_DEFAULT_TYPE=cpx21
# Optional: override the API base URL (defaults to https://api.hetzner.cloud/v1)
# HETZNER_API_URL=https://api.hetzner.cloud/v1

# Contabo Cloud (https://new.contabo.com/)
CONTABO_CLIENT_ID=REPLACE_WITH_CONTABO_CLIENT_ID
CONTABO_CLIENT_SECRET=REPLACE_WITH_CONTABO_CLIENT_SECRET
CONTABO_API_USERNAME=REPLACE_WITH_CONTABO_API_USERNAME
CONTABO_API_PASSWORD=REPLACE_WITH_CONTABO_API_PASSWORD
CONTABO_DEFAULT_REGION=EU
CONTABO_DEFAULT_PLAN=VPS_1
CONTABO_IMAGE_ID=REPLACE_WITH_CONTABO_IMAGE_ID
CONTABO_SSH_KEY_ID=REPLACE_WITH_CONTABO_SSH_KEY_ID
# Optional: override the API and token endpoints.
# CONTABO_API_URL=https://api.contabo.com
# CONTABO_AUTH_URL=https://auth.contabo.com/auth/realms/contabo/protocol/openid-connect/token

# Headscale / Tailscale mesh used by new hosts to join the control plane.
# HEADSCALE_CONTROL_PLANE_URL is passed to bootstrap-host.sh for `tailscale up`.
# HEADSCALE_PREAUTH_KEY is a reusable pre-auth key (or ephemeral key).
HEADSCALE_CONTROL_PLANE_URL=https://mail.news.allternit.com:8444
HEADSCALE_PREAUTH_KEY=REPLACE_WITH_HEADSCALE_PREAUTH_KEY

# -----------------------------------------------------------------------------
# Fabric provider adapters
# -----------------------------------------------------------------------------

# Runpod GPU cloud (https://www.runpod.io/console/settings/api-keys)
RUNPOD_API_TOKEN=REPLACE_WITH_RUNPOD_API_TOKEN
# Optional: override the GraphQL endpoint (defaults to https://api.runpod.io/graphql)
# RUNPOD_API_URL=https://api.runpod.io/graphql
# Optional: default container image for Runpod pods
# RUNPOD_DEFAULT_IMAGE=runpod/pytorch:2.2.0-py3.10-cuda12.1-devel-ubuntu22.04

# Vast.ai GPU marketplace (https://cloud.vast.ai/account/api-keys/)
VAST_API_KEY=REPLACE_WITH_VAST_API_KEY
# Optional: override the API base URL (defaults to https://console.vast.ai/api/v0)
# VAST_API_URL=https://console.vast.ai/api/v0
# Optional: default container image for Vast instances
# VAST_DEFAULT_IMAGE=ubuntu:22.04

# Headscale gRPC mesh enrollment endpoint (optional; used by /api/v1/mesh/enroll).
# HEADSCALE_API_KEY=REPLACE_WITH_HEADSCALE_API_KEY
# HEADSCALE_GRPC_ADDR=http://127.0.0.1:50443
# HEADSCALE_CONTROL_URL=https://mail.news.allternit.com:8444

# Autoscaler / worker tuning. All values are optional and default as shown.
# DESKTOP_HOST_PROVISIONER_INTERVAL_SECS=60
# DESKTOP_CAPACITY_MONITOR_INTERVAL_SECS=30
# DESKTOP_QUEUE_WORKER_INTERVAL_SECS=10
# DESKTOP_AUTOSCALE_CPU_THRESHOLD=0.75
# DESKTOP_AUTOSCALE_MEMORY_THRESHOLD=0.80
