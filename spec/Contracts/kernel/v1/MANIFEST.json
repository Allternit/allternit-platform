  "frozen_date": "2026-09-30",
  "approved_by": "Eoj, 2026-09-30 (09-v1.4-disposition.md §E)",
  "decisions": {
    "Q1": "191 primitive ids (ledger CL-021..CL-094)",
    "Q2": "no gen.*/vcs.* namespaces; generation in domain namespace with class G; VCS under obs.vcs.*/mut.vcs.*",
    "Q3": "closed contracts (additionalProperties:false) + extensions map with x-* keys on every closed $defs object",
    "Q4": "hashes sha256:<64 hex>; timestamps RFC 3339 strings",
    "Q5": "AgentStateV1 drops locks (LeaseV1.scope owns locks); budgets = resolved limits only; user_visible_status display-only",
    "Q6": "Primitive Pack + decision-bank manifests DEFERRED to 1.1; BUG_FIX pack shipped as data",
    "Q7": "class legend D/S/G/V/P/M/R per §1; unconfirmed per-id classes null"
  },
  "ownership": {
    "_rule": "Q2 store split: every mutable field path has exactly one authoritative owner contract. Other contracts link to it only through *_ref / *_id fields (Id or StateVersionRef), never embedded copies. Receipts are append-only and own nothing mutable. Version stamps (state_version, work_state_version) are per-record write stamps, not owned state.",
    "semantic_state": {
      "owner": "AgentStateV1",
      "fields": [
        "user_intent",
        "acceptance",
        "constraints",
        "environment",
        "repository",
        "active_packs",
        "plan",
        "graph_cursor",
        "hypotheses",
        "candidate_targets",
        "selected_targets",
        "context_index",
        "relevant_context",
        "generated_artifacts",
        "mutations",
        "command_history",
        "diagnostics",
        "verification",
        "unresolved_failures",
        "evidence",
        "permissions",
        "model_state",
        "subgoals",
        "completion",
        "instruction_predicates",
        "sensitivity_labels",
        "retrieval_snapshot_refs",
        "user_visible_status"
      ]
    },
    "run_budget_resolved_limits": {
      "owner": "AgentStateV1",
      "fields": [
        "budgets"
      ]
    },
    "node_lifecycle": {
      "owner": "WorkNodeLifecycleV1",
      "fields": [
        "state",
        "close_outcome",
        "attempt"
      ]
    },
    "lease_and_locks": {
      "owner": "LeaseV1",
      "fields": [
        "holder",
        "host",
        "process_or_session",
        "scope",
        "heartbeat_at",
        "expires_after_ms",
        "reclaim_policy"
      ]
    },
    "node_output": {
      "owner": "NodeOutputV1",
      "fields": [
        "artifact_id",
        "hash",
        "verification_status"
      ]
    },
    "campaign": {
      "owner": "CampaignV1",
      "fields": [
        "status",
        "objective",
