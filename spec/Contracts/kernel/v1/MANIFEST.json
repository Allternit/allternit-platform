{
  "package": "allternit-kernel-abi",
  "package_version": "1.0.0",
  "status": "FROZEN",
  "version_axes": {
    "doc": "Living Architecture v1.4",
    "abi_package": "1.0.0",
    "runtime": "unbound (runtime versions declare required_abi_versions)",
    "per_contract": "V-suffix in the contract name = major; schema_version (semver) per contract below"
  },
  "schema_base": "https://schemas.allternit.com/kernel/1.0.0/",
  "authority": "Living Architecture v1.4 > 07 decisions + 09 disposition > 02 canonical contracts > this ABI (frozen 1.0.0) > conformance/reference packs > code > donors",
  "evolution_rules": [
    "breaking change = new major (V2)",
    "unknown required field/enum fails closed",
    "unknown optional data preserved in `extensions` (x-* keys)",
    "receipts append-only",
    "every durable write increments state_version or records explicit no-op",
    "additive change (new optional field, new enum member, new contract) = ABI minor bump (1.x.0); receivers fail closed on unknown enum values and unknown fields",
    "breaking change to any contract = ABI 2.0.0",
    "frozen files are never edited in place; errata go into a patch release (1.0.x) that does not change validation results"
  ],
  "notes": {
    "wih_projection": "Q3: the WIH DAG is a read-only projection of ComputeGraphIRV1 (node -> WIH task, edge -> dependency). No WIH schema is part of the ABI and nothing parses a WIH DAG back into a graph.",
    "store_split": "Q2: AgentStateV1 (agent_state.schema.json) = semantic truth; work.schema.json + campaign.schema.json + attention.schema.json = Work Runtime ledger. Cross-refs via common StateVersionRef.",
    "deferred": [
      "DeploymentProfileV1 (ABI 1.1; bundle carries opaque deployment_profiles ids)",
      "DatasetReceiptV1",
      "DecisionCalibrationManifest deep content (WP8; gate fields are in 1.0.0)",
      "PrimitivePackManifestV1 (ABI 1.1; referenced by opaque ids active_packs / bundle.primitive_packs)",
      "DecisionBankManifestV1 (ABI 1.1; referenced by opaque decision_bank_id / bundle.decision_banks)",
      "API v0.3 content_hash prefix alignment (sha256:<hex>) — API change, tracked outside the ABI package"
    ]
  },
