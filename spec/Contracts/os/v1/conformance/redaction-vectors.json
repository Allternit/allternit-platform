      "input": "[default]\naws_access_key_id = TESTONLYNOTAREALID00\naws_secret_access_key = TestOnly/NotARealSecret/0000000000000000\n",
      "secrets": [],
      "absent": ["TESTONLYNOTAREALID00", "TestOnly/NotARealSecret/0000000000000000"],
      "present": ["[default]", "aws_access_key_id", "aws_secret_access_key"]
