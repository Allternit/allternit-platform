      "input": "max_tokens=4096 PWD=/Users/joe/project token_count: 12345678901234567890 author: Joe Smith password: true commit 3f2a9c1e8b7d6a5f4e3d2c1b0a9f8e7d6c5b4a39",
      "secrets": [],
      "absent": [],
      "present": ["max_tokens=4096", "PWD=/Users/joe/project", "token_count: 12345678901234567890", "author: Joe Smith", "password: true", "3f2a9c1e8b7d6a5f4e3d2c1b0a9f8e7d6c5b4a39"]
