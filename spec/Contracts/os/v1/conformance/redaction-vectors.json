{
  "schema": "allternit.os.redaction-vectors.v1",
  "about": "Shared test vectors for the one secret redactor (plan step 10, CONTRACT.md 2.3). Read by the Rust tests in cmd/allternit-api/src/authority/redact.rs and the TS tests in cmd/gizzi-code/test/util/secret-redactor.test.ts. `input` is a string or an array of strings joined with no separator (provider-shaped fakes are split so secret scanners do not flag this file; none of them is a real key). `secrets` are the exact values the kernel attached during the call. `mode` is `tool_result` (default) or `credential_file` (an approved read of a .env or credential file: every assignment value is masked). After redaction no `absent` string may appear and every `present` string must still appear.",
  "mask": "[REDACTED]",
  "vectors": [
    {
      "name": "attached value echoed by a command",
      "input": "export DEPLOY_KEY_VALUE=my-plain-vault-value-42 && echo done",
      "secrets": ["my-plain-vault-value-42"],
      "absent": ["my-plain-vault-value-42"],
      "present": ["echo done"]
    },
    {
      "name": "attached value echoed base64-encoded",
      "input": "encoded: bXktcGxhaW4tdmF1bHQtdmFsdWUtNDI=",
      "secrets": ["my-plain-vault-value-42"],
      "absent": ["bXktcGxhaW4tdmF1bHQtdmFsdWUtNDI"],
      "present": ["encoded:"]
    },
    {
      "name": "attached value with no credential shape",
      "input": "the shared phrase is plum orchard seven",
      "secrets": ["plum orchard seven"],
      "absent": ["plum orchard seven"],
      "present": ["the shared phrase is"]
    },
    {
      "name": "openai project key",
      "input": ["OPENAI says: ", "sk-", "proj-", "Zx9TestOnlyNotARealKey00000000abcd", " was used"],
      "secrets": [],
      "absent": ["Zx9TestOnlyNotARealKey00000000abcd"],
      "present": ["OPENAI says:", "was used"]
    },
    {
      "name": "anthropic key",
